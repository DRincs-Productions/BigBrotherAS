    # Alice 01 "Конечно, мам! Приятного аппетита..."
    Alice 01 "Certo, mamma! Buon appetito..."

# game/scripts/story_02/breakfasts.rpy:32
translate italian ev2_breakfast_r1_3cc30d0a:

    # Lisa 01 "Спасибо, мам! Приятного аппетита..."
    Lisa 01 "Grazie, mamma! Buon appetito..."

# game/scripts/story_02/breakfasts.rpy:34
translate italian ev2_breakfast_r1_f9ece009:

    # tMax 11 "Ммм... Мама всегда готовит очень вкусно! А что до разговоров, то особо ничего интересного не прозвучало. У всех всё в порядке..."
    tMax 11 "Mmm... La mamma cucina sempre del cibo delizioso! Per quanto riguarda le conversazioni, non è stato detto nulla di particolarmente interessante. Stanno tutti bene..."

# game/scripts/story_02/breakfasts.rpy:45
