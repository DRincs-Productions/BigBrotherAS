# TODO: Translation updated at 2026-07-03 17:21 #|#|# # game/scripts/story_01/pool.rpy:11 #-#-# translate crowdin alice_swims_talk_2c2308f4:
msgid "[_Alice_s_01_] Может быть. А что, тоже хочешь? Ну, присоединяйся... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:19 #-#-# translate crowdin alice_swims_talk_8df2e30a:
msgid "[_Alice_s_05_] Ухх, как водичка освежает! Такой отдых мне по душе. С огромной радостью только бы загорала и плавала весь день. [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:23 #-#-# translate crowdin alice_swims_talk_4854f023:
msgid "[_Alice_s_02_] Как хочешь. Я и одна прекрасно поплаваю."
msgstr ""

# game/scripts/story_01/pool.rpy:24 #-#-# translate crowdin alice_swims_talk_fb0b0639:
msgid "[_Max_s_01_] Не буду тебе мешать..."
msgstr ""

# game/scripts/story_01/pool.rpy:31 #-#-# translate crowdin alice_swims_talk_ac3fb787:
msgid "[_Alice_s_01_] Ко мне не надо, а в бассейн, пожалуйста. Я всё равно уже наплавалась и выхожу... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:35 #-#-# translate crowdin alice_swims_talk_a919a0f2:
msgid "[_Alice_s_04_] Что, Макс, одному неинтересно плавать? Как жаль..."
msgstr ""

# game/scripts/story_01/pool.rpy:37 #-#-# translate crowdin alice_swims_talk_3c4e89a0:
msgid "[_tMax_s_03_] Это смотря о чём жалеть... Ведь поглазеть на то, как вода стекает по сексуальной попке Алисы я тоже люблю! [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:48 #-#-# translate crowdin alice_swims_talk_28ec3293:
msgid "[_Alice_s_01_] Ко мне не надо, а в бассейн, пожалуйста. Можешь попробовать... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:55 #-#-# translate crowdin alice_swims_talk_c48de440:
msgid "[_Alice_s_05_] Главное до всяких малолетних забав не опускайся. Я хочу отдохнуть без всяких там детских визгов и брызг во все стороны... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:59 #-#-# translate crowdin alice_swims_talk_4854f023_1:
msgid "[_Alice_s_02_] Как хочешь. Я и одна прекрасно поплаваю."
msgstr ""

# game/scripts/story_01/pool.rpy:60 #-#-# translate crowdin alice_swims_talk_fb0b0639_1:
msgid "[_Max_s_01_] Не буду тебе мешать..."
msgstr ""

# game/scripts/story_01/pool.rpy:76 #-#-# translate crowdin alice_swims_talk_swims_afcd201b:
msgid "[_tMax_s_01_] Это точно. Я бы тоже только так и отдыхал, если бы у нас был полон двор девчонок в бикини и без... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:82 #-#-# translate crowdin alice_swims_talk_swims_e274d786:
msgid "[_tMax_s_04_] Но и то, что сейчас есть во дворе, тоже очень неплохо выглядит! И желания появляются очень пошлые... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:88 #-#-# translate crowdin alice_swims_talk_swims_5986111d:
msgid "[_Alice_s_14_] А-а-а!!! Чтоб тебя, Макс! Напугал, блин, я аж чуть из бассейна не выпрыгнула!"
msgstr ""

# game/scripts/story_01/pool.rpy:89 #-#-# translate crowdin alice_swims_talk_swims_a7f3365e:
msgid "[_Max_s_06_] Ха-ха! Классно я придумал, да?"
msgstr ""

# game/scripts/story_01/pool.rpy:93 #-#-# translate crowdin alice_swims_talk_swims_a817133b:
msgid "[_Alice_s_16_] Сейчас я тебе покажу! Ну как, классно тебе?! Запомни, нефиг меня пугать! Иначе огребёшь... Понял?"
msgstr ""

# game/scripts/story_01/pool.rpy:94 #-#-# translate crowdin alice_swims_talk_swims_ef5a773b:
msgid "[_Max_s_15_] Да ладно тебе, Алиса, это же шутка была! Слезь с меня, а то я утону..."
msgstr ""

# game/scripts/story_01/pool.rpy:96 #-#-# translate crowdin alice_swims_talk_swims_24bf6fa1:
msgid "[_Alice_s_04_] Что ты говоришь, я не расслышала? Ты как будто воды в рот набрал. А брызг-то от тебя сколько! [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:101 #-#-# translate crowdin alice_swims_talk_swims_7bb24e95:
msgid "[_Alice_s_02_] Ты уже наплавался, что ли? Было же так классно..."
msgstr ""

# game/scripts/story_01/pool.rpy:102 #-#-# translate crowdin alice_swims_talk_swims_4ec6b2fa:
msgid "[_Max_s_12_] Да как-то опасно с тобой плавать. На суше лучше..."
msgstr ""

# game/scripts/story_01/pool.rpy:109 #-#-# translate crowdin alice_swims_talk_swims_e5abb306:
msgid "[_Alice_s_02_] Ты уже наплавался, что ли?"
msgstr ""

# game/scripts/story_01/pool.rpy:110 #-#-# translate crowdin alice_swims_talk_swims_d665a78a:
msgid "[_Max_s_01_] Ага. Давай, не скучай..."
msgstr ""

# game/scripts/story_01/pool.rpy:126 #-#-# translate crowdin lisa_swims_talk_731b6e1d:
msgid "[_Lisa_s_01_] Как раз собиралась. Если хочешь, присоединяйся... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:134 #-#-# translate crowdin lisa_swims_talk_9aeae577:
msgid "[_Lisa_s_05_] Ой, как хорошо! Стояла бы такая погода всегда. Я бы тогда купалась и загорала, пока не надоест. [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:138 #-#-# translate crowdin lisa_swims_talk_fe429d30:
msgid "[_Lisa_s_02_] Ну и зря! Водичка тёплая."
msgstr ""

# game/scripts/story_01/pool.rpy:139 #-#-# translate crowdin lisa_swims_talk_469ec5b1:
msgid "[_Max_s_01_] У меня есть дела..."
msgstr ""

# game/scripts/story_01/pool.rpy:145 #-#-# translate crowdin lisa_swims_talk_1618539a:
msgid "[_Lisa_s_01_] Ой, вообще-то, я собиралась вылазить. Бассейн такой большой, я уже устала плавать... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:149 #-#-# translate crowdin lisa_swims_talk_25cc23a5:
msgid "[_Lisa_s_03_] Фух... Надеюсь, что такая погода будет стоять здесь всегда..."
msgstr ""

# game/scripts/story_01/pool.rpy:151 #-#-# translate crowdin lisa_swims_talk_37395abf:
msgid "[_tMax_s_03_] И я надеюсь... Ведь тогда я смогу очень часто наслаждаться столь прелестными изгибами моей мокренькой младшей сестрёнки! [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:161 #-#-# translate crowdin lisa_swims_talk_28ca610f:
msgid "[_Lisa_s_01_] Присоединяйся, если хочешь. Бассейн большой... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:168 #-#-# translate crowdin lisa_swims_talk_be468145:
msgid "[_Lisa_s_05_] С такой солнечной погодой только и остаётся, что дома прятаться. Но в бассейне куда приятнее... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:172 #-#-# translate crowdin lisa_swims_talk_fe429d30_1:
msgid "[_Lisa_s_02_] Ну и зря! Водичка тёплая."
msgstr ""

# game/scripts/story_01/pool.rpy:173 #-#-# translate crowdin lisa_swims_talk_469ec5b1_1:
msgid "[_Max_s_01_] У меня есть дела..."
msgstr ""

# game/scripts/story_01/pool.rpy:189 #-#-# translate crowdin lisa_swims_talk_swims_2888b1b8:
msgid "[_tMax_s_01_] Приятно наблюдать, как Лиза плавает. Так задорно своими стройными ножками двигает... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:195 #-#-# translate crowdin lisa_swims_talk_swims_706e6985:
msgid "[_tMax_s_04_] А как она под водой красиво смотрится! Так и хочется сделать что-нибудь эдакое... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:200 #-#-# translate crowdin lisa_swims_talk_swims_f18b7f46:
msgid "[_Lisa_s_14_] Ай, Макс!!! Не пугай меня так! Я даже не заметила, как ты подо мной оказался!"
msgstr ""

# game/scripts/story_01/pool.rpy:201 #-#-# translate crowdin lisa_swims_talk_swims_caad5e80:
msgid "[_Max_s_01_] Я бы предупредил, что выныриваю, но был под водой..."
msgstr ""

# game/scripts/story_01/pool.rpy:205 #-#-# translate crowdin lisa_swims_talk_swims_0e3a4e6d:
msgid "[_Lisa_s_03_] Очень смешно! Тебе там не тяжело меня на шее держать, я ведь уже не маленькая?"
msgstr ""

# game/scripts/story_01/pool.rpy:206 #-#-# translate crowdin lisa_swims_talk_swims_2404fd21:
msgid "[_Max_s_12_] Нет, ты стройненькая и лёгкая... Фух..."
msgstr ""

# game/scripts/story_01/pool.rpy:208 #-#-# translate crowdin lisa_swims_talk_swims_55045227:
msgid "[_Lisa_s_11_] Ну да, я и вижу, что твоя голова всё больше и больше под воду уходит. Я, пожалуй, поплыву дальше, пока ты не утонул... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:213 #-#-# translate crowdin lisa_swims_talk_swims_422e89f1:
msgid "[_Lisa_s_02_] Ты что, Макс, уже наплавался? Или обессилел, пока меня держал на себе?"
msgstr ""

# game/scripts/story_01/pool.rpy:214 #-#-# translate crowdin lisa_swims_talk_swims_81745dbd:
msgid "[_Max_s_11_] Мне на сегодня плавания уже хватило."
msgstr ""

# game/scripts/story_01/pool.rpy:221 #-#-# translate crowdin lisa_swims_talk_swims_cd4ffcfe:
msgid "[_Lisa_s_02_] Ты что, Макс, уже наплавался?"
msgstr ""

# game/scripts/story_01/pool.rpy:222 #-#-# translate crowdin lisa_swims_talk_swims_bae8e776:
msgid "[_Max_s_01_] Ага. Пора делами заниматься..."
msgstr ""

# game/scripts/story_01/pool.rpy:240 #-#-# translate crowdin ann_night_swim_talk_b57b44c1:
msgid "[_Ann_s_02_] Почему бы и нет? Пускай без солнышка, но водичка всё равно тёплая... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:247 #-#-# translate crowdin ann_night_swim_talk_296cd094:
msgid "[_tMax_s_03_] Правильно, такую сногсшибательную фигуру нужно держать в тонусе и красиво подвигаться в воде перед сном самое то... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:257 #-#-# translate crowdin ann_night_swim_talk_7c507641:
msgid "[_Ann_s_02_] Немного, чтобы спалось крепче. Ложиться скоро, а сна ни в одном глазу... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:263 #-#-# translate crowdin ann_night_swim_talk_296cd094_1:
msgid "[_tMax_s_03_] Правильно, такую сногсшибательную фигуру нужно держать в тонусе и красиво подвигаться в воде перед сном самое то... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:284 #-#-# translate crowdin ann_swim_talk_7b0614e9:
msgid "[_Ann_s_02_] Обязательно! Если хочешь, присоединяйся? Поплаваем вместе... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:292 #-#-# translate crowdin ann_swim_talk_2f495a84:
msgid "[_Ann_s_04_] Как же хорошо иметь собственный бассейн, да ещё и в таком прекрасном месте. И погода балует. [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:297 #-#-# translate crowdin ann_swim_talk_ac967fd5:
msgid "[_Ann_s_11_] Ну, как хочешь!"
msgstr ""

# game/scripts/story_01/pool.rpy:298 #-#-# translate crowdin ann_swim_talk_fb0b0639:
msgid "[_Max_s_01_] Не буду тебе мешать..."
msgstr ""

# game/scripts/story_01/pool.rpy:305 #-#-# translate crowdin ann_swim_talk_0c0c6760:
msgid "[_Ann_s_02_] Я уже наплавалась, но ты всё равно запрыгивай. В такую жаркую погоду милое дело освежиться и поплавать... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:309 #-#-# translate crowdin ann_swim_talk_eefbf21f:
msgid "[_Ann_s_03_] Я всё не нарадуюсь тому, что у нас есть свой собственный бассейн! Просто красота..."
msgstr ""

# game/scripts/story_01/pool.rpy:311 #-#-# translate crowdin ann_swim_talk_0a6094e7:
msgid "[_tMax_s_03_] О да! Это именно то, что приходит мне на ум, когда я вижу шикарную и такую мокрую мамину попку! Просто красота... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:322 #-#-# translate crowdin ann_swim_talk_1e085c87:
msgid "[_Ann_s_02_] Запрыгивай. В такую жаркую погоду милое дело освежиться и поплавать... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:329 #-#-# translate crowdin ann_swim_talk_a9ac540e:
msgid "[_Ann_s_04_] Лучше места для отдыха и не придумать. Почти, как на дорогом курорте... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:334 #-#-# translate crowdin ann_swim_talk_ac967fd5_1:
msgid "[_Ann_s_11_] Ну, как хочешь!"
msgstr ""

# game/scripts/story_01/pool.rpy:335 #-#-# translate crowdin ann_swim_talk_fb0b0639_1:
msgid "[_Max_s_01_] Не буду тебе мешать..."
msgstr ""

# game/scripts/story_01/pool.rpy:350 #-#-# translate crowdin ann_swim_talk_swims_344421a4:
msgid "[_tMax_s_01_] Не могу не согласиться с мамой. Но ещё больше мне нравится любоваться тем, как она красиво плавает... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:355 #-#-# translate crowdin ann_swim_talk_swims_00e8e7d2:
msgid "[_tMax_s_04_] А под водой вообще одно загляденье! Мамины аппетитные формы так и манят сделать что-нибудь непристойное... [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:361 #-#-# translate crowdin ann_swim_talk_swims_613b3a40:
msgid "[_Ann_s_11_] Ах ты... Вот что ты, Макс, делаешь? Взял и обрызгал меня, а ещё говоришь, что уже взрослый."
msgstr ""

# game/scripts/story_01/pool.rpy:362 #-#-# translate crowdin ann_swim_talk_swims_7446adaf:
msgid "[_Max_s_06_] Как будто взрослые так делать не могут?"
msgstr ""

# game/scripts/story_01/pool.rpy:366 #-#-# translate crowdin ann_swim_talk_swims_ede4485c:
msgid "[_Ann_s_04_] Ха, ещё как могут! Вот так тебе... Будешь знать, как на маму волны пускать! Нравится баловаться, да?"
msgstr ""

# game/scripts/story_01/pool.rpy:367 #-#-# translate crowdin ann_swim_talk_swims_1a52bbb6:
msgid "[_Max_s_16_] Я просто повеселиться хотел, мам! Прекращай, а то у меня глаза уже ничего не видят из-за брызг..."
msgstr ""

# game/scripts/story_01/pool.rpy:369 #-#-# translate crowdin ann_swim_talk_swims_aacfd085:
msgid "[_Ann_s_03_] В следующий раз, когда снова захочешь повеселиться со мной в бассейне, обязательно вспомни, что тебя ждёт в ответ! [nointeract]"
msgstr ""

# game/scripts/story_01/pool.rpy:373 #-#-# translate crowdin ann_swim_talk_swims_1572cacc:
msgid "[_Ann_s_02_] Сынок, давай ещё поплаваем или ты всё? Или ты обиделся?"
msgstr ""

# game/scripts/story_01/pool.rpy:374 #-#-# translate crowdin ann_swim_talk_swims_e2630c69:
msgid "[_Max_s_12_] Нет, мне уши нужно просушить, а то заложило от воды."
msgstr ""

# game/scripts/story_01/pool.rpy:381 #-#-# translate crowdin ann_swim_talk_swims_62441e5e:
msgid "[_Ann_s_02_] Сынок, давай ещё поплаваем или ты всё?"
msgstr ""

# game/scripts/story_01/pool.rpy:382 #-#-# translate crowdin ann_swim_talk_swims_51d819fe:
msgid "[_Max_s_01_] Ага. Мне нужно идти..."
msgstr ""

