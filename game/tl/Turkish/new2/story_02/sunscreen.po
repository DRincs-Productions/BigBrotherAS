# TODO: Translation updated at 2026-11-11 21:13 #|#|# # game/scripts/story_02/sunscreen.rpy:7 #-#-# translate crowdin ev2_006_b6b59d01:
msgid "[_Kira_s_01_] Не просто хорошо, а отпадно! Словно я попала на самый настоящий курорт. [nointeract]"
msgstr ""

# game/scripts/story_02/sunscreen.rpy:26 #-#-# translate crowdin ev2_006_e8ee7016:
msgid "[_Kira_s_04_] А теперь я ещё и восхищённым мужским взглядом не обделена, что безусловно ещё больше стало радовать."
msgstr ""

# game/scripts/story_02/sunscreen.rpy:27 #-#-# translate crowdin ev2_006_01a65507:
msgid "[_Max_s_01_] Этим я могу обеспечить без проблем, тётя Кира, ведь восхищаться есть чем..."
msgstr ""

# game/scripts/story_02/sunscreen.rpy:28 #-#-# translate crowdin ev2_006_fc9d2b30:
msgid "[_Kira_s_03_] Ой, всё, засмущал тётю, хи-хи..."
msgstr ""

# game/scripts/story_02/sunscreen.rpy:30 #-#-# translate crowdin ev2_006_6260402b:
msgid "[_tMax_s_04_] Засмущаешь её, как же... Чувствовать себя так комфортно и расслабленно в настолько откровенном купальнике далеко не каждая женщина сможет, а Кира от этого ещё и явно балдеет... [nointeract]"
msgstr ""

# game/scripts/story_02/sunscreen.rpy:42 #-#-# translate crowdin ev2_006_add08dff:
msgid "[_Kira_s_02_] Да, это было бы очень кстати! Сама я что-то ленюсь это делать."
msgstr ""

# game/scripts/story_02/sunscreen.rpy:46 #-#-# translate crowdin ev2_006_060fad4e:
msgid "[_Max_s_12_] Увы, его нет. Но в другой раз обязательно будет..."
msgstr ""

# game/scripts/story_02/sunscreen.rpy:51 #-#-# translate crowdin ev2_006_e7ea9016:
msgid "[_Max_s_12_] Увы, оно почти закончилось. Но в другой раз обязательно будет..."
msgstr ""

# game/scripts/story_02/sunscreen.rpy:56 #-#-# translate crowdin ev2_006_8791568f:
msgid "[_Max_s_01_] А вот мне не лень. Устраивайся поудобнее..."
msgstr ""

# game/scripts/story_02/sunscreen.rpy:65 #-#-# translate crowdin ev2_006_3d81279b:
msgid "[_Kira_s_01_] Я готова, Макс... Как же повезло, что у нас есть такой заботливый мужчина в семье. [nointeract]"
msgstr ""

# game/scripts/story_02/sunscreen.rpy:74 #-#-# translate crowdin ev2_006_8d771db3:
msgid "[_tMax_s_02_] Такую женщину, как тётя Кира, хочется не только натирать маслом, но и хорошенько потискать все её соблазнительные округлости... Вот и готово!"
msgstr ""

# game/scripts/story_02/sunscreen.rpy:75 #-#-# translate crowdin ev2_006_8c7c5629:
msgid "[_Kira_s_05_] Ох, Макс, спасибо тебе большое! Сама бы я так приятно себе не сделала."
msgstr ""

# game/scripts/story_02/sunscreen.rpy:76 #-#-# translate crowdin ev2_006_c3c3e71e:
msgid "[_Max_s_11_] Ножки тебе тоже натереть?"
msgstr ""

# game/scripts/story_02/sunscreen.rpy:80 #-#-# translate crowdin ev2_006_028871d2:
msgid "[_Kira_s_03_] Ну, твои руки уже в масле, так что грех будет не пройтись по всей моей коже..."
msgstr ""

# game/scripts/story_02/sunscreen.rpy:82 #-#-# translate crowdin ev2_006_1adb9138:
msgid "[_Max_s_02_] Легко. Один момент... [nointeract]"
msgstr ""

# game/scripts/story_02/sunscreen.rpy:88 #-#-# translate crowdin ev2_006_ca35fb4d:
msgid "[_tMax_s_01_] Мои руки с такой лёгкостью катаются по тётиным ножкам! Они у неё и без того гладкие, а уж с маслом так вообще сказка..."
msgstr ""

# game/scripts/story_02/sunscreen.rpy:94 #-#-# translate crowdin ev2_006_f4cf0851:
msgid "[_Kira_s_02_] Умничка, Макс! Сервис у вас здесь просто потрясающий. Да и мой купальник, я смотрю, уже не так сильно тебя... будоражит..."
msgstr ""

# game/scripts/story_02/sunscreen.rpy:96 #-#-# translate crowdin ev2_006_14af69e3:
msgid "[_Max_s_03_] Я уже более-менее к нему привык. Отдыхай, тётя Кира. [nointeract]"
msgstr ""

