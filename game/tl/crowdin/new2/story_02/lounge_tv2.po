# game/scripts/story_02/lounge_tv2.rpy:299 #-#-# translate crowdin ev2_016_53e233bd:
msgid "[_Alice_s_04_] Хм... А ты уверен, Макс, что стоит идти на такие «хитрости» в отношении своей родной сестры? Сильно рискуешь..."
msgstr "[_Alice_s_04_] Хм... А ты уверен, Макс, что стоит идти на такие «хитрости» в отношении своей родной сестры? Сильно рискуешь..."

# game/scripts/story_02/lounge_tv2.rpy:300 #-#-# translate crowdin ev2_016_44355642:
msgid "[_Max_s_09_] Ухх... Просто проверял, вдруг тебе понравится..."
msgstr "[_Max_s_09_] Ухх... Просто проверял, вдруг тебе понравится..."

# game/scripts/story_02/lounge_tv2.rpy:304 #-#-# translate crowdin ev2_016_bdb1d7d8:
msgid "[_Alice_s_06_] Думаю, по движениям моих ног ты уже во всю почувствовал, насколько мне это нравится?! Они у меня все, снизу доверху, как одна сплошная эрогенная зона..."
msgstr "[_Alice_s_06_] Думаю, по движениям моих ног ты уже во всю почувствовал, насколько мне это нравится?! Они у меня все, снизу доверху, как одна сплошная эрогенная зона..."

# game/scripts/story_02/lounge_tv2.rpy:305 #-#-# translate crowdin ev2_016_8fbca215:
msgid "[_Max_s_08_] Ох, Алиса! Даже удивительно, что ты можешь быть такой нежной. От тебя привычнее ожидать другого..."
msgstr "[_Max_s_08_] Ох, Алиса! Даже удивительно, что ты можешь быть такой нежной. От тебя привычнее ожидать другого..."

# game/scripts/story_02/lounge_tv2.rpy:308 #-#-# translate crowdin ev2_016_0ad6ce6b:
msgid "[_Alice_s_04_] Да, я могу вести себя вот так... Двигать ножками жёстче и быстрее! Но мне не хочется сейчас торопиться, хи-хи..."
msgstr "[_Alice_s_04_] Да, я могу вести себя вот так... Двигать ножками жёстче и быстрее! Но мне не хочется сейчас торопиться, хи-хи..."

# game/scripts/story_02/lounge_tv2.rpy:309 #-#-# translate crowdin ev2_016_d4edf1c0:
msgid "[_Max_s_09_] Чёрт, а я уже, кажется, всё..."
msgstr "[_Max_s_09_] Чёрт, а я уже, кажется, всё..."

# game/scripts/story_02/lounge_tv2.rpy:313 #-#-# translate crowdin ev2_016_7e434680:
msgid "[_Alice_s_14_] Макс, ты что, кончил?! Да ещё и на меня! Ну что за фигня..."
msgstr "[_Alice_s_14_] Макс, ты что, кончил?! Да ещё и на меня! Ну что за фигня..."

# game/scripts/story_02/lounge_tv2.rpy:314 #-#-# translate crowdin ev2_016_410d043d:
msgid "[_Max_s_11_] А ты хотела по-другому?"
msgstr "[_Max_s_11_] А ты хотела по-другому?"

# game/scripts/story_02/lounge_tv2.rpy:321 #-#-# translate crowdin ev2_016_1bee93d6:
msgid "[_Alice_s_04_] Да, я могу вести себя вот так... Двигать ножками жёстче и быстрее! Но мне не хочется сейчас торопиться, хи-хи... [nointeract]"
msgstr "[_Alice_s_04_] Да, я могу вести себя вот так... Двигать ножками жёстче и быстрее! Но мне не хочется сейчас торопиться, хи-хи... [nointeract]"

# game/scripts/story_02/lounge_tv2.rpy:329 #-#-# translate crowdin ev2_016_d92c5fec:
msgid "[_Alice_s_07_] Знаешь, этот массаж просто сводит меня с ума, Макс! Мои сосочки уже во всю ноют от возбуждения... Представляешь?"
msgstr "[_Alice_s_07_] Знаешь, этот массаж просто сводит меня с ума, Макс! Мои сосочки уже во всю ноют от возбуждения... Представляешь?"

# game/scripts/story_02/lounge_tv2.rpy:330 #-#-# translate crowdin ev2_016_3f7aa6b7:
msgid "[_Max_s_07_] Ну-ка покажи... Ух ты какие классные! Похоже, уже твёрденькие..."
msgstr "[_Max_s_07_] Ну-ка покажи... Ух ты какие классные! Похоже, уже твёрденькие..."

# game/scripts/story_02/lounge_tv2.rpy:335 #-#-# translate crowdin ev2_016_36d54bff:
msgid "[_Alice_s_05_] Ммм... Именно так, Макс. Как думаешь, это будет слишком, если я не удержусь и полезу руками в свои трусики?"
msgstr "[_Alice_s_05_] Ммм... Именно так, Макс. Как думаешь, это будет слишком, если я не удержусь и полезу руками в свои трусики?"

# game/scripts/story_02/lounge_tv2.rpy:336 #-#-# translate crowdin ev2_016_e57ec373:
msgid "[_Max_s_02_] Так ты уже..."
msgstr "[_Max_s_02_] Так ты уже..."

# game/scripts/story_02/lounge_tv2.rpy:337 #-#-# translate crowdin ev2_016_d76b1c12:
msgid "[_Alice_s_04_] Ой, и правда! Чуть не начала ласкать себя пальчиками прямо на глазах собственного брата, хи-хи..."
msgstr "[_Alice_s_04_] Ой, и правда! Чуть не начала ласкать себя пальчиками прямо на глазах собственного брата, хи-хи..."

# game/scripts/story_02/lounge_tv2.rpy:338 #-#-# translate crowdin ev2_016_d4edf1c0_1:
