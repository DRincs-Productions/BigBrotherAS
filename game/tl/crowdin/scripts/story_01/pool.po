# game/scripts/story_02/pool.rpy:18 #-#-# translate crowdin kira_swim_talk_ebe9d5e9:
msgid "[_Kira_s_03_] Ухх... Водичка - отпад! Так освежает, если сперва хорошенько прогреться на солнышке. [nointeract]"
msgstr "[_Kira_s_03_] Ухх... Водичка - отпад! Так освежает, если сперва хорошенько прогреться на солнышке. [nointeract]"

# game/scripts/story_02/pool.rpy:22 #-#-# translate crowdin kira_swim_talk_88787938:
msgid "[_Kira_s_04_] Смотри, потом захочешь, а меня тут уже не будет!"
msgstr "[_Kira_s_04_] Смотри, потом захочешь, а меня тут уже не будет!"

# game/scripts/story_02/pool.rpy:23 #-#-# translate crowdin kira_swim_talk_438501f6:
msgid "[_Max_s_01_] Пока мне не до этого..."
msgstr "[_Max_s_01_] Пока мне не до этого..."

# game/scripts/story_02/pool.rpy:30 #-#-# translate crowdin kira_swim_talk_9164bc92:
msgid "[_Kira_s_02_] Макс, вот где ты был раньше, а? Я так хорошо наплавалась и уже выхожу... [nointeract]"
msgstr "[_Kira_s_02_] Макс, вот где ты был раньше, а? Я так хорошо наплавалась и уже выхожу... [nointeract]"

# game/scripts/story_02/pool.rpy:34 #-#-# translate crowdin kira_swim_talk_ca72902e:
msgid "[_Kira_s_04_] В следующий раз подходи раньше и тогда сможем поплавать вместе! Водичка, кстати, отпад..."
msgstr "[_Kira_s_04_] В следующий раз подходи раньше и тогда сможем поплавать вместе! Водичка, кстати, отпад..."

# game/scripts/story_02/pool.rpy:36 #-#-# translate crowdin kira_swim_talk_85b60abe:
msgid "[_tMax_s_03_] Вернее было бы сказать, что не водичка отпадная, а то, как отпадно смотрится тётина попка, когда по ней стекает вода... [nointeract]"
msgstr "[_tMax_s_03_] Вернее было бы сказать, что не водичка отпадная, а то, как отпадно смотрится тётина попка, когда по ней стекает вода... [nointeract]"

# game/scripts/story_02/pool.rpy:46 #-#-# translate crowdin kira_swim_talk_435a2a53:
msgid "[_Kira_s_02_] Я буду только рада. Запрыгивай, пока голову ещё не успело напечь... [nointeract]"
msgstr "[_Kira_s_02_] Я буду только рада. Запрыгивай, пока голову ещё не успело напечь... [nointeract]"

# game/scripts/story_02/pool.rpy:51 #-#-# translate crowdin kira_swim_talk_a0476136:
msgid "[_Kira_s_03_] Ну вот, теперь стало немного повеселее. Такой большой дом и бассейн, а поплавать не с кем... [nointeract]"
