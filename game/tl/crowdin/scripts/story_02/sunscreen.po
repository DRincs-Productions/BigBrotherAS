# game/scripts/story_02/sunscreen.rpy:25 #-#-# translate crowdin ev2_006_sunbathe_01a65507:
msgid "[_Max_s_01_] Этим я могу обеспечить без проблем, тётя Кира, ведь восхищаться есть чем..."
msgstr "[_Max_s_01_] Этим я могу обеспечить без проблем, тётя Кира, ведь восхищаться есть чем..."

# game/scripts/story_02/sunscreen.rpy:26 #-#-# translate crowdin ev2_006_sunbathe_fc9d2b30:
msgid "[_Kira_s_03_] Ой, всё, засмущал тётю, хи-хи..."
msgstr "[_Kira_s_03_] Ой, всё, засмущал тётю, хи-хи..."

# game/scripts/story_02/sunscreen.rpy:28 #-#-# translate crowdin ev2_006_sunbathe_6260402b:
msgid "[_tMax_s_04_] Засмущаешь её, как же... Чувствовать себя так комфортно и расслабленно в настолько откровенном купальнике далеко не каждая женщина сможет, а Кира от этого ещё и явно балдеет... [nointeract]"
msgstr "[_tMax_s_04_] Засмущаешь её, как же... Чувствовать себя так комфортно и расслабленно в настолько откровенном купальнике далеко не каждая женщина сможет, а Кира от этого ещё и явно балдеет... [nointeract]"

