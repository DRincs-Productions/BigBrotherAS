# game/scripts/story_02/breakfasts.rpy:34 #-#-# translate crowdin ev2_breakfast_r1_f9ece009:
msgid "[_tMax_s_11_] Ммм... Мама всегда готовит очень вкусно! А что до разговоров, то особо ничего интересного не прозвучало. У всех всё в порядке..."
msgstr "[_tMax_s_11_] Ммм... Мама всегда готовит очень вкусно! А что до разговоров, то особо ничего интересного не прозвучало. У всех всё в порядке..."

# game/scripts/story_02/breakfasts.rpy:45 #-#-# translate crowdin ev2_001_6e8dcf3c:
