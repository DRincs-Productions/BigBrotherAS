msgstr "Плохие"

# game/scripts/engine/characters.rpy:535
msgid "Неплохие"
msgstr "Неплохие"

# game/scripts/engine/characters.rpy:535
msgid "Хорошие"
msgstr "Хорошие"

# game/scripts/engine/characters.rpy:535
