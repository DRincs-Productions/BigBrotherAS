# TODO: Translation updated at 2026-06-22 22:36 #|#|# # game/scripts/story_02/housework.rpy:15 #-#-# translate crowdin ev2_002_b373e0af:
msgid "[_Ann_s_01_] Макс, зайди ко мне в комнату. У меня для тебя кое-что есть. [nointeract]"
msgstr "[Max, viens dans ma chambre. J'ai quelque chose pour toi. [nointeract]"

# game/scripts/story_02/housework.rpy:20 #-#-# translate crowdin ev2_002_ae5f46e6:
msgid "[_Ann_s_00_] Сейчас выдам тебе денежку. Дела по дому у тебя всё те же, что и до этого. Чистка пола, бассейна, а так же газон и продукты."
msgstr "[_Ann_s_00_] Je vais vous donner l'argent maintenant. Vos tâches ménagères sont les mêmes qu'avant. Nettoyer le sol, la piscine, la pelouse et les courses."

# game/scripts/story_02/housework.rpy:21 #-#-# translate crowdin ev2_002_47affb53:
msgid "[_Max_s_11_] Да, мам, я помню. Всё будет сделано."
msgstr "[Oui, maman, je me souviens. Ce sera fait."

# game/scripts/story_02/housework.rpy:29 #-#-# translate crowdin ev2_002_36252b40:
msgid "[_Ann_s_02_] Ты меня порадовал тем, что сделал всё на прошлой неделе вовремя, поэтому получаешь полную сумму. Это карманные $30 за эту неделю, за чистку пола $10, за газон $20, за чистку бассейна $20 и $10 за поход в магазин."
msgstr "[Tu m'as fait plaisir en faisant tout à temps la semaine dernière, alors tu as droit à la totalité de la somme. C'est une poche de 30 $ pour cette semaine, 10 $ pour le nettoyage du sol, 20 $ pour la pelouse, 20 $ pour le nettoyage de la piscine et 10 $ pour aller au magasin."

# game/scripts/story_02/housework.rpy:30 #-#-# translate crowdin ev2_002_d6746cca:
msgid "[_Max_s_03_] Спасибо! Я обязательно всё отработаю."
msgstr "[Merci ! Je ne manquerai pas de m'en occuper."

# game/scripts/story_02/housework.rpy:34 #-#-# translate crowdin ev2_002_d26a0781:
msgid "[_Ann_s_01_] Постарайся управиться со всеми делами до выходных, чтобы мне не пришлось тебе об этом напоминать или ругаться с тобой по этому поводу."
msgstr ""

# game/scripts/story_02/housework.rpy:35 #-#-# translate crowdin ev2_002_21571792:
msgid "[_Max_s_01_] Ладно, мам. Хорошего тебе дня на работе."
msgstr "[Ok, maman. Passe une bonne journée au travail."

# game/scripts/story_02/housework.rpy:37 #-#-# translate crowdin ev2_002_59616669:
msgid "[_Ann_s_03_] Спасибо, дорогой, что помогаешь. Ступай, маме нужно собираться на работу. [nointeract]"
msgstr "[Merci, ma chère, de m'avoir aidée. Allez, maman doit se préparer pour le travail. [nointeract]"

# game/scripts/story_02/housework.rpy:43 #-#-# translate crowdin ev2_002_9ed871d7:
msgid "[_Ann_s_10_] С некоторыми делами ты дотянул до выходных, чего я просила не делать, поэтому получишь меньше, чем мог бы. Это карманные $30 за эту неделю, за чистку пола ($10 или $5), за газон ($20 или $10), за чистку бассейна ($20 или $10) и ($10 или $5) за поход в магазин."
msgstr ""

# game/scripts/story_02/housework.rpy:44 #-#-# translate crowdin ev2_002_96242e44:
msgid "[_Max_s_12_] Эх... Но всё равно спасибо! Я обязательно всё отработаю."
msgstr "[_Max_s_12_] Eh... Mais merci quand même ! Je ne manquerai pas de m'en occuper."

# game/scripts/story_02/housework.rpy:48 #-#-# translate crowdin ev2_002_0ad2528e:
msgid "[_Ann_s_12_] Надеюсь, в этот раз ты управишься со всеми делами до выходных, чтобы мне не пришлось тебе об этом снова напоминать или ругаться с тобой по этому поводу."
msgstr ""

# game/scripts/story_02/housework.rpy:49 #-#-# translate crowdin ev2_002_21571792_1:
msgid "[_Max_s_01_] Ладно, мам. Хорошего тебе дня на работе."
msgstr "[Ok, maman. Passe une bonne journée au travail."

# game/scripts/story_02/housework.rpy:51 #-#-# translate crowdin ev2_002_4ca105bd:
msgid "[_Ann_s_01_] Как бы там ни было, но спасибо, дорогой, что помогаешь. Ступай, маме нужно собираться на работу. [nointeract]"
msgstr "[Quoi qu'il en soit, merci, chérie, de m'avoir aidée. Allez, maman doit se préparer pour le travail. [nointeract]"

# game/scripts/story_02/housework.rpy:57 #-#-# translate crowdin ev2_002_3fcaa0eb:
msgid "[_Ann_s_14_] Ты умудрился дотянуть со всеми делами до выходных, чего я просила не делать, поэтому за сами дела получишь только половину. Это карманные $30 за эту неделю, за чистку пола $5, за газон $10, за чистку бассейна $10 и $5 за поход в магазин."
msgstr "[Tu as réussi à faire toutes les corvées avant le week-end, ce que je t'avais demandé de ne pas faire, donc tu ne reçois que la moitié pour les corvées elles-mêmes. C'est une poche de 30 $ pour cette semaine, 5 $ pour nettoyer le sol, 10 $ pour la pelouse, 10 $ pour nettoyer la piscine et 5 $ pour aller au magasin."

# game/scripts/story_02/housework.rpy:58 #-#-# translate crowdin ev2_002_8a4fa143:
msgid "[_Max_s_14_] Виноват... Но всё равно спасибо! Я обязательно всё отработаю."
msgstr "[_Max_s_14_] C'est ma faute... Mais merci quand même ! Je vais faire en sorte de régler tout ça."

# game/scripts/story_02/housework.rpy:62 #-#-# translate crowdin ev2_002_0ad2528e_1:
msgid "[_Ann_s_12_] Надеюсь, в этот раз ты управишься со всеми делами до выходных, чтобы мне не пришлось тебе об этом снова напоминать или ругаться с тобой по этому поводу."
msgstr ""

# game/scripts/story_02/housework.rpy:63 #-#-# translate crowdin ev2_002_21571792_2:
msgid "[_Max_s_01_] Ладно, мам. Хорошего тебе дня на работе."
msgstr "[Ok, maman. Passe une bonne journée au travail."

# game/scripts/story_02/housework.rpy:65 #-#-# translate crowdin ev2_002_5b7701f1:
msgid "[_Ann_s_10_] Дисциплина у тебя пока хромает, но всё равно спасибо, что помогаешь. Ступай, маме нужно собираться на работу. [nointeract]"
msgstr "[Votre discipline est encore un peu laxiste, mais merci de nous aider. Allez, maman doit se préparer pour le travail. [nointeract]"

