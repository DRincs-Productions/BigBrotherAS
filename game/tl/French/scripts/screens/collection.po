# TODO: Translation updated at 2026-07-03 17:20 #|#|# # game/scripts/screens/collection.rpy:754 #-#-# translate crowdin compile_puzzle_start_e29c0251:
msgid "Данное изображение разбито на множество фрагментов."
msgstr "Cette image est brisée en plusieurs fragments."

# game/scripts/screens/collection.rpy:755 #-#-# translate crowdin compile_puzzle_start_70f9d915:
msgid "Чтобы правильно его собрать, вам потребуется поворачивать эти фрагменты (при нажатии) и перемещать их (зажать и перетащить в другое место)."
msgstr "Pour l'assembler correctement, vous devrez faire pivoter ces pièces (en cliquant) et les déplacer (en les pinçant et en les faisant glisser vers un autre endroit)."

# game/scripts/screens/collection.rpy:758 #-#-# translate crowdin compile_puzzle_start_600592cc:
msgid "Если окантовка фрагмента красного цвета, то его нужно переместить и повернуть."
msgstr ""

# game/scripts/screens/collection.rpy:759 #-#-# translate crowdin compile_puzzle_start_96342d1d:
msgid "Если окантовка фрагмента оранжевого цвета, то его нужно только переместить."
msgstr ""

# game/scripts/screens/collection.rpy:760 #-#-# translate crowdin compile_puzzle_start_4522cd23:
msgid "Если окантовка фрагмента голубого цвета, то его нужно только повернуть."
msgstr ""

# game/scripts/screens/collection.rpy:796 #-#-# translate crowdin compile_puzzle_win_77c1ec18:
msgid "Головоломка решена!"
msgstr "Puzzle résolu !"

# game/scripts/screens/collection.rpy:797 #-#-# translate crowdin compile_puzzle_win_7e7566c8:
msgid "Данное изображение можно в любой момент просмотреть в Галерее."
msgstr "Cette image peut être consultée à tout moment dans la galerie."

