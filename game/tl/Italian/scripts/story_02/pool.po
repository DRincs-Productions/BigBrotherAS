# TODO: Translation updated at 2026-07-03 17:21 #|#|# # game/scripts/story_02/pool.rpy:10 #-#-# translate crowdin kira_swim_talk_63e1428e:
msgid "[_Kira_s_02_] Да вот как раз собиралась. Ты тоже присоединяйся, вдвоём повеселее будет... [nointeract]"
msgstr "[_Kira_s_02_] In realtà mi stavo proprio preparando per farlo. Unisciti anche tu, in due sarà più divertente... [nointeract]"

# game/scripts/story_02/pool.rpy:18 #-#-# translate crowdin kira_swim_talk_ebe9d5e9:
msgid "[_Kira_s_03_] Ухх... Водичка - отпад! Так освежает, если сперва хорошенько прогреться на солнышке. [nointeract]"
msgstr "[_Kira_s_03_] Wow... L'acqua è fantastica! Ti rinfresca un sacco dopo che ti sei preso un bel po' di caldo al sole. [nointeract]"

# game/scripts/story_02/pool.rpy:22 #-#-# translate crowdin kira_swim_talk_88787938:
msgid "[_Kira_s_04_] Смотри, потом захочешь, а меня тут уже не будет!"
msgstr "[_Kira_s_04_] Guarda che poi ti andrà, ma io non sarò più qui!"

# game/scripts/story_02/pool.rpy:23 #-#-# translate crowdin kira_swim_talk_438501f6:
msgid "[_Max_s_01_] Пока мне не до этого..."
msgstr "[_Max_s_01_] Al momento ho altro a cui pensare..."

# game/scripts/story_02/pool.rpy:30 #-#-# translate crowdin kira_swim_talk_9164bc92:
msgid "[_Kira_s_02_] Макс, вот где ты был раньше, а? Я так хорошо наплавалась и уже выхожу... [nointeract]"
msgstr "[_Kira_s_02_] Max, ma dove sei stato finora? Mi sono fatta una nuotata fantastica e adesso sto uscendo... [nointeract]"

# game/scripts/story_02/pool.rpy:34 #-#-# translate crowdin kira_swim_talk_ca72902e:
msgid "[_Kira_s_04_] В следующий раз подходи раньше и тогда сможем поплавать вместе! Водичка, кстати, отпад..."
msgstr "[_Kira_s_04_] La prossima volta muoviti a venire, così ci facciamo il bagno insieme! Comunque l'acqua è fantastica..."

# game/scripts/story_02/pool.rpy:36 #-#-# translate crowdin kira_swim_talk_85b60abe:
msgid "[_tMax_s_03_] Вернее было бы сказать, что не водичка отпадная, а то, как отпадно смотрится тётина попка, когда по ней стекает вода... [nointeract]"
msgstr "[_tMax_s_03_] Sarebbe più corretto dire che non è l'acqua a essere uno sballo, ma lo sballo che fa il culetto della zia con l'acqua che ci scivola sopra... [nointeract]"

# game/scripts/story_02/pool.rpy:46 #-#-# translate crowdin kira_swim_talk_435a2a53:
msgid "[_Kira_s_02_] Я буду только рада. Запрыгивай, пока голову ещё не успело напечь... [nointeract]"
msgstr "[_Kira_s_02_] Non mi dispiacerebbe affatto. Salta dentro, prima che il sole ti dia alla testa... [nointeract]"

# game/scripts/story_02/pool.rpy:51 #-#-# translate crowdin kira_swim_talk_a0476136:
msgid "[_Kira_s_03_] Ну вот, теперь стало немного повеселее. Такой большой дом и бассейн, а поплавать не с кем... [nointeract]"
msgstr "[_Kira_s_03_] Beh, adesso ci si diverte un po' di più. Una casa così grande con tanto di piscina, e non avere nessuno con cui nuotare... [nointeract]"

# game/scripts/story_02/pool.rpy:55 #-#-# translate crowdin kira_swim_talk_88787938_1:
msgid "[_Kira_s_04_] Смотри, потом захочешь, а меня тут уже не будет!"
msgstr "[_Kira_s_04_] Guarda che poi ti andrà, ma io non sarò più qui!"

# game/scripts/story_02/pool.rpy:56 #-#-# translate crowdin kira_swim_talk_438501f6_1:
msgid "[_Max_s_01_] Пока мне не до этого..."
msgstr "[_Max_s_01_] Al momento ho altro a cui pensare..."

# game/scripts/story_02/pool.rpy:71 #-#-# translate crowdin kira_swim_talk_swims_9425b088:
msgid "[_tMax_s_01_] Точно подмечено. Хотя мне больше нравится смотреть сквозь рябь воды на такие волнующие и полуголые тётины формы, которые периодически показываются на поверхности... [nointeract]"
msgstr "[_tMax_s_01_] Proprio così. Anche se a me piace di più guardare attraverso i riflessi dell'acqua le forme così eccitanti e seminude della zia, che ogni tanto riemergono in superficie... [nointeract]"

# game/scripts/story_02/pool.rpy:76 #-#-# translate crowdin kira_swim_talk_swims_e7338efd:
msgid "[_tMax_s_04_] Да и под водой картина открывается уж точно нисколько не хуже! Столько шаловливых мыслей сразу появляется, когда любуешься её пышными изгибами... [nointeract]"
msgstr "[_tMax_s_04_] E di sicuro la vista da sott'acqua non è mica peggio! Mi vengono certi pensieri maliziosi a guardare quelle sue curve così procaci... [nointeract]"

# game/scripts/story_02/pool.rpy:83 #-#-# translate crowdin kira_swim_talk_swims_250c60fd:
msgid "[_Kira_s_01_] Как-то ты маловато поплавал, Макс. Точно не останешься?"
msgstr "[_Kira_s_01_] Ci sei rimasto poco in acqua, Max. Non ti fermi ancora un po'?"

# game/scripts/story_02/pool.rpy:84 #-#-# translate crowdin kira_swim_talk_swims_683256bb:
msgid "[_Max_s_01_] Мне пока этого хватило..."
msgstr "[_Max_s_01_] Per ora mi è bastato..."

# §translate crowdin strings: #|#|# # game/scripts/story_02/pool.rpy:11
msgid "Погнали!"
msgstr "Andiamo!"

# game/scripts/story_02/pool.rpy:19
msgid "{i}поплавать с Кирой{/i}"
msgstr "{i}Nuotare con Kira{/i}"

# game/scripts/story_02/pool.rpy:48
msgid "Один момент!"
msgstr "Un momento!"

