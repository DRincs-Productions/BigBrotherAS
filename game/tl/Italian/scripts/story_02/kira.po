# TODO: Translation updated at 2026-07-03 17:21 #|#|# # game/scripts/story_02/kira.rpy:12 #-#-# translate crowdin ev2_003_06ac2f3b:
msgid "[_Ann_s_02_] Ну что, вот и дождались... Встречайте, к нам приехала тётя Кира!"
msgstr "[_Ann_s_02_] Beh, alla fine l'attesa è finita... Date il benvenuto alla zia Kira, è arrivata da noi!"

# game/scripts/story_02/kira.rpy:13 #-#-# translate crowdin ev2_003_858bca8a:
msgid "[_Max_s_06_] Супер! Здравствуй, тётя Кира!"
msgstr "[_Max_s_06_] Super! Ciao, zia Kira!"

# game/scripts/story_02/kira.rpy:14 #-#-# translate crowdin ev2_003_086f8bc7:
msgid "[_Kira_s_12_] Ого, это кто тут у нас?! Макс? Я тебя не узнала! Как же ты подрос с нашей последней встречи!"
msgstr "[_Kira_s_12_] Oh, guarda un po' chi c'è qui! Max? Non ti avevo riconosciuto! Come sei cresciuto dall'ultima volta che ci siamo visti!"

# game/scripts/story_02/kira.rpy:15 #-#-# translate crowdin ev2_003_f848353d:
msgid "[_Max_s_05_] Тётя, а ты... шикарней некуда!"
msgstr "[_Max_s_05_] Zia, ma tu... Sei pazzesca!"

# game/scripts/story_02/kira.rpy:19 #-#-# translate crowdin ev2_003_9f69e2b8:
msgid "[_Kira_s_02_] Ой, Макс, спасибо! Так давно не виделись, дай я тебя обниму... Вижу, всё у тебя в порядке. Приятно, что хоть один у нас мужчина, но есть в семье..."
msgstr "[_Kira_s_02_] Oh, Max, grazie! È da così tanto che non ci vediamo, lasciati abbracciare... Vedo che è tutto a posto. Mi fa piacere vedere che almeno un vero uomo ci sia rimasto in questa famiglia..."

# game/scripts/story_02/kira.rpy:20 #-#-# translate crowdin ev2_003_45347230:
msgid "[_Max_s_04_] Ага, сам удивляюсь, как у меня сил и нервов на вас всех хватает."
msgstr "[_Max_s_04_] Eh già, mi stupisco da solo di come io trovi ancora la forza e la pazienza per tutti voi."

# game/scripts/story_02/kira.rpy:22 #-#-# translate crowdin ev2_003_7e5cb989:
msgid "[_Ann_s_12_] Макс, ты сильно на тёте не повисай, дай ей с дороги хоть немного отдохнуть. И вообще, пойдёмте в дом, завтракать же пора... [nointeract]"
msgstr "[_Ann_s_12_] Max, non stare troppo addosso alla zia, lasciala riposare un attimo dopo il viaggio. E comunque, entriamo in casa, è ora di fare colazione... [nointeract]"

# game/scripts/story_02/kira.rpy:30 #-#-# translate crowdin ev2_003_0906f4bb:
msgid "[_tMax_s_03_] Ммм... А тётя-то у меня огонь какая! Видимо, раньше мне не было до этого дела, но сейчас, крепко прижимаясь к её пышной груди, мне очень сильно хочется ей по-хозяйски овладеть..."
msgstr "[_tMax_s_03_] Mmm... Però, che schianto mia zia! È un fuoco! A quanto pare prima non ci badavo, ma ora, stringendomi forte al suo seno prosperoso, mi viene una voglia matta di possederla da padrone..."

# game/scripts/story_02/kira.rpy:34 #-#-# translate crowdin ev2_003_6d21ba9c:
msgid "[_Kira_s_04_] Ну вот, теперь можно и завтракать идти. Кстати, а где Лиза и Алиса?"
msgstr "[_Kira_s_04_] Bene, adesso possiamo andare a fare colazione. A proposito, dove sono Lisa e Alice?"

# game/scripts/story_02/kira.rpy:41 #-#-# translate crowdin ev2_003_8f75cbb4:
msgid "[_Kira_s_04_] Да, позавтракать я бы не отказалась. Кстати, а где Лиза и Алиса?"
msgstr "[_Kira_s_04_] Sì, non mi dispiacerebbe affatto fare colazione. A proposito, dove sono Lisa e Alice?"

# game/scripts/story_02/kira.rpy:46 #-#-# translate crowdin ev2_003_8f75cbb4_1:
msgid "[_Kira_s_04_] Да, позавтракать я бы не отказалась. Кстати, а где Лиза и Алиса?"
msgstr "[_Kira_s_04_] Sì, non mi dispiacerebbe affatto fare colazione. A proposito, dove sono Lisa e Alice?"

# game/scripts/story_02/kira.rpy:48 #-#-# translate crowdin ev2_003_c3eac1fc:
msgid "[_Max_s_11_] Они сейчас прибегут..."
msgstr "[_Max_s_11_] Adesso arrivano di corsa..."

# game/scripts/story_02/kira.rpy:54 #-#-# translate crowdin ev2_003_c5b63610:
msgid "[_Kira_s_03_] Лиза? Алиса? Неужели, это вы? Все такие большие, скоро с меня ростом будете!"
msgstr "[_Kira_s_03_] Lisa? Alice? Ma siete davvero voi? Siete diventate così grandi, tra poco sarete alte quanto me!"

# game/scripts/story_02/kira.rpy:55 #-#-# translate crowdin ev2_003_db0730d6:
msgid "[_Lisa_s_04_] Тётя Кира! Ура! Я так соскучилась!"
msgstr "[_Lisa_s_04_] Zia Kira! Evviva! Mi sei mancata tantissimo!"

# game/scripts/story_02/kira.rpy:56 #-#-# translate crowdin ev2_003_85f7253a:
msgid "[_Alice_s_04_] Как здорово, что ты приехала! Надолго?"
msgstr "[_Alice_s_04_] Che bello che tu sia venuta! Ti fermi per molto?"

# game/scripts/story_02/kira.rpy:57 #-#-# translate crowdin ev2_003_c9566ecc:
msgid "[_Kira_s_11_] А что, уже выгоняете меня?!"
msgstr "[_Kira_s_11_] Ma come, mi cacciate già?!"

# game/scripts/story_02/kira.rpy:58 #-#-# translate crowdin ev2_003_7e59b903:
msgid "[_Ann_s_03_] Что ты, Кира, оставайся столько, сколько захочешь! Мы все здесь тебе рады, сестрёнка!"
msgstr "[_Ann_s_03_] Ma che dici, Kira, resta pure tutto il tempo che vuoi! Siamo tutti felicissimi di averti qui, sorellina!"

# game/scripts/story_02/kira.rpy:59 #-#-# translate crowdin ev2_003_888691e1:
msgid "[_Max_s_01_] Да, тётя, у нас места много..."
msgstr "[_Max_s_01_] Sì, zia, da noi c'è un sacco di spazio..."

# game/scripts/story_02/kira.rpy:60 #-#-# translate crowdin ev2_003_67252437:
msgid "[_Ann_s_04_] Кира, ты в этом развратном платье и в самолёте летела? Надеюсь, там все пассажиры пережили полёт, потому что юбка у тебя прямо на грани..."
msgstr "[_Ann_s_04_] Kira, ma hai viaggiato in aereo con questo vestito così provocante? Spero che tutti i passeggeri siano sopravvissuti al volo, perché quella gonna è davvero al limite..."

# game/scripts/story_02/kira.rpy:61 #-#-# translate crowdin ev2_003_7412aae9:
msgid "[_Kira_s_02_] Я прилетела пару дней назад и остановилась в гостинице. Нельзя же было заявиться к вам без подарков, вот я все выходные и бегала по магазинам."
msgstr "[_Kira_s_02_] In realtà sono arrivata un paio di giorni fa e ho preso una stanza in hotel. Non potevo mica presentarmi da voi senza regali, così ho passato tutto il weekend a correre per negozi."

# game/scripts/story_02/kira.rpy:62 #-#-# translate crowdin ev2_003_9257cc81:
msgid "[_Max_s_05_] Ух-ты! Тогда пойдёмте на веранду, там и расскажешь, что купила..."
msgstr "[_Max_s_05_] Wow! Allora andiamo in veranda, così ci racconti cosa hai comprato..."

# game/scripts/story_02/kira.rpy:66 #-#-# translate crowdin ev2_003_24747f5c:
msgid "[_Kira_s_04_] Я уже в курсе вашей истории с потерянным вещами. Поэтому, я уточнила у вашей мамы ваши размеры и купила лёгкую домашнюю одежду. И, кажется, правильно сделала. В такую жару, дома, лучше носить что-нибудь лёгкое!"
msgstr "[_Kira_s_04_] Sono già al corrente della vostra storia dei vestiti smarriti. Perciò ho chiesto le vostre taglie a vostra madre e vi ho comprato dell'abbigliamento leggero per stare in casa. E, a quanto pare, ho fatto bene! Con questo caldo, in casa, è meglio indossare qualcosa di leggero!"

# game/scripts/story_02/kira.rpy:67 #-#-# translate crowdin ev2_003_975024d3:
msgid "[_Lisa_s_03_] Ой! Я обожаю новые вещички. А что ты мне привезла, тётя Кира, а?"
msgstr "[_Lisa_s_03_] Oh! Io adoro i vestiti nuovi! Che cosa mi hai portato, zia Kira, eh?"

# game/scripts/story_02/kira.rpy:68 #-#-# translate crowdin ev2_003_33ddfcb6:
msgid "[_Max_s_11_] Я думал у нас Алиса шмотки любит..."
msgstr "[_Max_s_11_] E io che pensavo che fosse Alice quella fissata con i vestiti..."

# game/scripts/story_02/kira.rpy:69 #-#-# translate crowdin ev2_003_ddb9d309:
msgid "[_Lisa_s_02_] Макс, шмотки любят все девушки! Ну так что там?"
msgstr "[_Lisa_s_02_] Max, guarda che tutte le ragazze vanno matte per i vestiti! Allora, che c'è di bello là dentro?"

# game/scripts/story_02/kira.rpy:70 #-#-# translate crowdin ev2_003_2a1b9082:
msgid "[_Kira_s_03_] Так, вы все давайте держите новую одежду, переодевайтесь и возвращайтесь сюда. Посмотрим, всем ли всё подошло."
msgstr "[_Kira_s_03_] Allora, prendete ognuno i vostri vestiti nuovi, andate a cambiarvi e tornate qui. Vediamo se vi va tutto bene."

# game/scripts/story_02/kira.rpy:74 #-#-# translate crowdin ev2_003_075a2f94:
msgid "[_Max_s_12_] Э-э-э... Тётя Кира, а что на счёт меня?"
msgstr "[_Max_s_12_] Ehm... Zia Kira, e per me invece?"

# game/scripts/story_02/kira.rpy:75 #-#-# translate crowdin ev2_003_b6814bd7:
msgid "[_Kira_s_01_] А тебе, Макс, я ничего не купила. Подумала, что тебе и в шортах хорошо. Но не расстраивайся, что-нибудь и для тебя придумаем в скором времени, обязательно..."
msgstr "[_Kira_s_01_] Per te invece, Max, non ho preso nulla! Ho pensato che stessi già benissimo in pantaloncini. Ma non rimanerci male, ci inventeremo qualcosa anche per te molto presto, promesso..."

# game/scripts/story_02/kira.rpy:76 #-#-# translate crowdin ev2_003_b968c939:
msgid "[_Max_s_13_] Хорошо, ловлю на слове."
msgstr "[_Max_s_13_] Va bene, ti prendo in parola."

# game/scripts/story_02/kira.rpy:81 #-#-# translate crowdin ev2_003_bb28e5e0:
msgid "[_Lisa_s_03_] Ну как вам? Такой классный топ и юбочка, да ещё и мой любимый цвет!"
msgstr "[_Lisa_s_03_] Allora, che ne dite? Questo top e questa gonnellina sono fantastici, e poi è pure il mio colore preferito!"

# game/scripts/story_02/kira.rpy:82 #-#-# translate crowdin ev2_003_25bda8f3:
msgid "[_Kira_s_02_] Смотрится очень миленько! Надеюсь, вашей маме не покажется, что юбка немного коротковата. Лично мне кажется, что для дома такое отлично подходит..."
msgstr "[_Kira_s_02_] Ti sta davvero molto bene! Spero solo che a vostra madre la gonna non sembri un po' troppo corta. A me personalmente sembra che per stare in casa vada benissimo..."

# game/scripts/story_02/kira.rpy:83 #-#-# translate crowdin ev2_003_c2f7aac2:
msgid "[_Max_s_03_] Это точно! Ну-ка, повернись..."
msgstr "[_Max_s_03_] Verissimo! Dai, girati un po'..."

# game/scripts/story_02/kira.rpy:87 #-#-# translate crowdin ev2_003_649c3940:
msgid "[_Lisa_s_11_] Мне кажется, что она не слишком короткая. В самый раз! И теперь так свободно и легко... Спасибо тебе, тётя Кира!"
msgstr "[_Lisa_s_11_] A me non sembra troppo corta. È perfetta! E poi si sta così comode e leggere... Grazie, zia Kira!"

# game/scripts/story_02/kira.rpy:88 #-#-# translate crowdin ev2_003_ed73037b:
msgid "[_Kira_s_03_] Не за что, Лиза. Носи на здоровье..."
msgstr "[_Kira_s_03_] Figurati, Lisa. Sono davvero contenta che ti piaccia, goditelo..."

# game/scripts/story_02/kira.rpy:93 #-#-# translate crowdin ev2_003_0c426f1d:
msgid "[_Alice_s_03_] Теперь моя очередь! Как вам? Лично мне очень нравится! Давно надо было перейти на что-то полегче, чем мои джинсы..."
msgstr "[_Alice_s_03_] Ora tocca a me! Che ne dite? A me personalmente piace tantissimo! Era ora che passassi a qualcosa di più leggero dei miei soliti jeans..."

# game/scripts/story_02/kira.rpy:94 #-#-# translate crowdin ev2_003_a0b65e89:
msgid "[_Kira_s_02_] Именно, Алиса! Тело должно дышать, особенно в таком климате, как здесь."
msgstr "[_Kira_s_02_] Esatto, Alice! La pelle ha bisogno di respirare, soprattutto con un clima come questo."

# game/scripts/story_02/kira.rpy:95 #-#-# translate crowdin ev2_003_1fee625a:
msgid "[_Max_s_11_] Это точно! Я свои домашние джинсы надевать вообще больше не планирую. Жарко в них..."
msgstr "[_Max_s_11_] Hai proprio ragione! Non ho la minima intenzione di rimettermi i miei jeans in casa. Si muore di caldo con quelli..."

# game/scripts/story_02/kira.rpy:99 #-#-# translate crowdin ev2_003_73b6d738:
msgid "[_Alice_s_04_] Я на днях так удачно прикупила себе чёрные трусики и они отлично подходят под эту маечку. А то ведь у нас есть тут один... который любит заглядывать, куда не надо..."
msgstr "[_Alice_s_04_] L'altro giorno ho fatto proprio un ottimo acquisto: ho preso delle mutandine nere che si abbinano alla perfezione con questo top. Anche perché c'è un certo qualcuno qui... A cui piace un po' troppo sbirciare dove non dovrebbe..."

# game/scripts/story_02/kira.rpy:100 #-#-# translate crowdin ev2_003_894733f2:
msgid "[_Kira_s_04_] Что поделать, Алиса, у Макса возраст сейчас такой."
msgstr "[_Kira_s_04_] Che vuoi farci, Alice, Max è in quell'età adesso."

# game/scripts/story_02/kira.rpy:106 #-#-# translate crowdin ev2_003_61ec5844:
msgid "[_Ann_s_12_] Так, Кира, я понимаю, чем ты руководствовалась, подбирая для меня такой наряд, но я не ношу настолько откровенную одежду!"
msgstr "[_Ann_s_12_] Senti, Kira, capisco benissimo cosa ti passava per la testa quando hai scelto questo completo per me, ma io non porto vestiti così audaci!"

# game/scripts/story_02/kira.rpy:107 #-#-# translate crowdin ev2_003_d72f4ba4:
msgid "[_Kira_s_03_] Ань, ты только посмотри, как оно отлично сидит на тебе. И цвет идёт... Давайте же, поддержите вашу маму!"
msgstr "[_Kira_s_03_] Ma Anna, guarda solo come ti sta d'incanto! E questo colore ti dona tantissimo... Dai ragazze, aiutatemi a convincere vostra madre!"

# game/scripts/story_02/kira.rpy:108 #-#-# translate crowdin ev2_003_e17e7d05:
msgid "[_Max_s_02_] Мам, выглядишь превосходно! А сзади как?"
msgstr "[_Max_s_02_] Mamma, stai benissimo! E da dietro com'è?"

# game/scripts/story_02/kira.rpy:112 #-#-# translate crowdin ev2_003_5c94b745:
msgid "[_Ann_s_11_] Должна сказать, эти шортики такие странные по ощущениям. Вроде и закрыты достаточно, а всё равно полуголой себя чувствую..."
msgstr "[_Ann_s_11_] Devo dire che questi pantaloncini danno una sensazione davvero strana. All'apparenza coprono abbastanza, ma mi sento comunque mezza nuda..."

# game/scripts/story_02/kira.rpy:113 #-#-# translate crowdin ev2_003_b32fecaa:
msgid "[_Kira_s_01_] Ерунда! Привыкнешь. Теперь похоже моя очередь показать, что я буду носить. Сейчас только схожу, переоденусь..."
msgstr "[_Kira_s_01_] Ma ti pare! Ti ci abituerai. Ora mi sa che tocca a me farvi vedere cosa indosserò. Vado un secondo a cambiarmi..."

# game/scripts/story_02/kira.rpy:117 #-#-# translate crowdin ev2_003_ae8096af:
msgid "[_Ann_s_10_] Ну-ка, а вам она что тут надарила? Лиза, у тебя юбка не коротковата, случаем?"
msgstr "[_Ann_s_10_] Sentiamo un po', e a voi che cosa ha regalato di bello? Lisa, ma quella gonna non è un tantino corta, per caso?"

# game/scripts/story_02/kira.rpy:118 #-#-# translate crowdin ev2_003_155d2fa5:
msgid "[_Lisa_s_11_] Нет, мам, она же для дома."
msgstr "[_Lisa_s_11_] Нет, мам, она же для дома."

# game/scripts/story_02/kira.rpy:119 #-#-# translate crowdin ev2_003_dab53bdd:
msgid "[_Ann_s_14_] А ты, Алиса, в таком вот виде собираешься по дому ходить? Если присмотреться, то у тебя всю грудь видно! Ладно мы с Лизой, но ещё же Макс есть..."
msgstr "[_Ann_s_14_] E tu, Alice, avresti intenzione di girare per casa vestita così? Se ci fai caso, ti si vede praticamente tutto il seno! Un conto siamo io e Lisa, ma ricordati che in casa c'è anche Max..."

# game/scripts/story_02/kira.rpy:120 #-#-# translate crowdin ev2_003_ead64d53:
msgid "[_Alice_s_11_] Мам, я дома могу одеваться так, как мне нравится! Ну и что, что Макс. Ну, если и увидит что-то, пусть радуется, мне всё равно..."
msgstr "[_Alice_s_11_] Mamma, a casa posso vestirmi come mi pare! E allora se c'è Max? Beh, se anche vede qualcosa, che si rifaccia pure gli occhi, a me non cambia nulla..."

# game/scripts/story_02/kira.rpy:121 #-#-# translate crowdin ev2_003_f6246b85:
msgid "[_Ann_s_12_] Ох, ну как знаешь. Не жалуйся мне только потом..."
msgstr "[_Ann_s_12_] Oh, beh, fai come ti pare. Poi però non venire a lamentarti da me..."

# game/scripts/story_02/kira.rpy:125 #-#-# translate crowdin ev2_003_443b5960:
msgid "[_Kira_s_03_] Ну, как я вам? Хороша? И Ань, ни слова больше. Тебе всё кажется слишком открытое или откровенное."
msgstr "[_Kira_s_03_] Allora, come vi sembro? Uno schianto, eh? E Anna, non dire una parola di più. Per te è sempre tutto troppo scollato o provocante."

# game/scripts/story_02/kira.rpy:126 #-#-# translate crowdin ev2_003_514e0cf6:
msgid "[_Max_s_04_] Мне нравится, тётя Кира. Просто и со вкусом!"
msgstr "[_Max_s_04_] Mi piace, zia Kira. Semplice e con stile!"

# game/scripts/story_02/kira.rpy:130 #-#-# translate crowdin ev2_003_045cf541:
msgid "[_Kira_s_04_] Вот, слышала, Ань? Детям нравится... Естественно, если в семье есть мужчина, это накладывает свои ограничения, но нельзя же быть настолько зажатыми..."
msgstr "[_Kira_s_04_] Ecco, hai sentito, Anna? Ai ragazzi piace... Naturalmente, avere un uomo in casa comporta le sue restrizioni, ma non si può mica essere così inibite..."

# game/scripts/story_02/kira.rpy:131 #-#-# translate crowdin ev2_003_3a812cc1:
msgid "[_Ann_s_01_] Ладно, посмотрим. Кира, мне кажется, что не стоило тратиться на все эти подарки. Мы и так рады, что ты смогла к нам приехать... Но всё равно, большое спасибо!"
msgstr "[_Ann_s_01_] Va bene, vedremo. Kira, secondo me non dovevi spendere tutti questi soldi per i regali. Siamo già così felici che tu sia potuta venire a trovarci... Ma comunque, grazie di cuore!"

# game/scripts/story_02/kira.rpy:132 #-#-# translate crowdin ev2_003_6fd7e017:
msgid "[_Max_s_12_] Давайте уже завтракать, а то остыло почти всё..."
msgstr "[_Max_s_12_] Dai, facciamo colazione che ormai si è quasi raffreddato tutto..."

# game/scripts/story_02/kira.rpy:149 #-#-# translate crowdin ev_kira_dressed_in_front_of_max_0ce6d33b:
msgid "[_Kira_s_01_] Слушай, Макс, погуляй где-нибудь, а то мне нужно переодеться... [nointeract]"
msgstr "[_Kira_s_01_] Senti, Max, vai a farti un giro da qualche parte, che devo cambiarmi... [nointeract]"

# game/scripts/story_02/kira.rpy:159 #-#-# translate crowdin ev_kira_dressed_moment0_e294e19b:
msgid "[_Kira_s_01_] Слушай, Макс, ты можешь где-нибудь погулять, а то мне нужно переодеться... [nointeract]"
msgstr "[_Kira_s_01_] Senti, Max, puoi farti un giro da qualche parte? È che devo cambiarmi... [nointeract]"

# game/scripts/story_02/kira.rpy:162 #-#-# translate crowdin ev_kira_dressed_moment0_d936e0b6:
msgid "[_Kira_s_02_] Спасибо. Я быстренько. [nointeract]"
msgstr "[_Kira_s_02_] Grazie. Faccio subito! [nointeract]"

# game/scripts/story_02/kira.rpy:171 #-#-# translate crowdin ev_kira_dressed_moment2_acd526eb:
msgid "[_tMax_s_05_] Ого! Это я весьма удачно зашёл... {p=2}{nw}"
msgstr "[_tMax_s_05_] Wow! Direi che sono capitato proprio al momento giusto... {p=2}{nw}"

# game/scripts/story_02/kira.rpy:177 #-#-# translate crowdin ev_kira_dressed_moment2_5b8c6f84:
msgid "[_Kira_s_04_] Ай-я-яй, Макс! Ты так тихо ходишь, что я совершенно тебя не заметила! Хорошо, если ты только что зашёл, а не наблюдаешь с самого начала. [nointeract]"
msgstr "[_Kira_s_04_] Ehi, Max! Cammini così silenziosamente che non ti ho proprio sentito arrivare! Meno male se sei appena entrato, e non rimasto lì a guardare fin dall'inizio. [nointeract]"

# game/scripts/story_02/kira.rpy:191 #-#-# translate crowdin ev_kira_dressed_moment1_46d08f0c:
msgid "[_Kira_s_04_] Ай-я-яй, Макс! Как же тихо ты ходишь! Хорошо, что я успела прикрыть самое важное. [nointeract]"
msgstr "[_Kira_s_04_] Ai ai ai, Max! Ma quanto cammini silenzioso? Meno male che ho fatto in tempo a coprire i punti strategici... [nointeract]"

# game/scripts/story_02/kira.rpy:203 #-#-# translate crowdin ev_kira_dressed_until_end_45ec6988:
msgid "[_Kira_s_03_] Ага, значит, понравилось тебе, да?! В следующий раз позаботься о том, чтобы я тебя не увидела, если уж так хочешь досмотреть до конца, а сейчас лучше иди гуляй, пока я добрая. [nointeract]"
msgstr "[_Kira_s_03_] Ah, quindi ti è piaciuto, eh?! La prossima volta vedi di non farti beccare, se proprio ci tieni a guardare fino alla fine... Ma adesso fila a farti un giro, finché sono ancora buona. [nointeract]"

# game/scripts/story_02/kira.rpy:211 #-#-# translate crowdin ev_kira_dressed_until_end_baa66319:
msgid "[_Kira_s_10_] Даже вот так?! Уж не знаю, за кого ты свою родную тётю принимаешь, но иди-ка ты лучше гуляй, пока мы с тобой не поругались. [nointeract]"
msgstr "[_Kira_s_10_] Ah, addirittura?! Non so proprio per chi tu prenda tua zia, ma è meglio se vai a farti un giro prima che finiamo per litigare! [nointeract]"

# game/scripts/story_02/kira.rpy:222 #-#-# translate crowdin ev_kira_dressed_hide_beauty_318e4749:
msgid "[_Kira_s_02_] Ну, ещё бы... Твоей радости не было бы предела от этого. Лучше иди погуляй где-нибудь, пока я оденусь. [nointeract]"
msgstr "[_Kira_s_02_] Eh, ci credo... Non staresti più nella pelle, vero? Sarà meglio che vai a farti un giro da qualche parte mentre mi vesto. [nointeract]"

# game/scripts/story_02/kira.rpy:229 #-#-# translate crowdin ev_kira_dressed_hide_beauty_fb913cba:
msgid "[_Kira_s_10_] Макс, я вообще-то твоя тётя, а ты мне такое! Давай-ка погуляй лучше иди, а то ещё поругаемся с тобой. [nointeract]"
msgstr "[_Kira_s_10_] Max, guarda che sono tua zia, e tu mi dici certe cose! Dai, è meglio se vai a farti un giro, prima che finiamo per litigare. [nointeract]"

# game/scripts/story_02/kira.rpy:258 #-#-# translate crowdin ev_kira_dressed_in_bathroom_ba232146:
msgid "[_tMax_s_11_] Сейчас ванная комната должна быть занята тётей Кирой. Она собирается уходить по делам... [nointeract]"
msgstr "[_tMax_s_11_] In questo momento il bagno dovrebbe essere occupato da zia Kira. Sta per uscire a sbrigare alcune commissioni... [nointeract]"

# game/scripts/story_02/kira.rpy:260 #-#-# translate crowdin ev_kira_dressed_in_bathroom_7dc6f782:
msgid "[_tMax_s_11_] Сейчас ванная комната должна быть занята тётей Кирой. Она переодевается перед сном... [nointeract]"
msgstr "[_tMax_s_11_] In questo momento il bagno dovrebbe essere occupato da zia Kira. Si sta cambiando prima di andare a dormire... [nointeract]"

# game/scripts/story_02/kira.rpy:269 #-#-# translate crowdin ev_kira_dressed_in_bathroom_1d136386:
msgid "[_tMax_s_01_] Посмотрим, что она там делает..."
msgstr "[_tMax_s_01_] Vediamo cosa sta facendo laggiù..."

# game/scripts/story_02/kira.rpy:283 #-#-# translate crowdin ev_kira_dressed_in_bathroom_b69f7f67:
msgid "[_tMax_s_03_] Тётя у меня и так всегда сногсшибательна, а если ещё и сисечками голыми светит, то у меня в шортах вообще огонь что начинает твориться! [nointeract]"
msgstr "[_tMax_s_03_] Mia zia è già uno schianto di suo, ma se si mette pure a mostrare le tette nude, nei miei pantaloncini succede un macello! [nointeract]"

# game/scripts/story_02/kira.rpy:295 #-#-# translate crowdin ev_kira_dressed_in_bathroom_in_front_of_max_0ce6d33b:
msgid "[_Kira_s_01_] Слушай, Макс, погуляй где-нибудь, а то мне нужно переодеться... [nointeract]"
msgstr "[_Kira_s_01_] Senti, Max, vai a farti un giro da qualche parte, che devo cambiarmi... [nointeract]"

# game/scripts/story_02/kira.rpy:316 #-#-# translate crowdin ev2_007_1ede10c7:
msgid "[_Kira_s_01_] Ну что, Макс... Меня не теряй, я должна вернуться, хоть и буду поздно..."
msgstr "[_Kira_s_01_] Allora, Max... Non darmi per dispersa, io tornerò comunque, anche se farò tardi..."

# game/scripts/story_02/kira.rpy:317 #-#-# translate crowdin ev2_007_5d78ec65:
msgid "[_Max_s_01_] Успехов тебе, тётя Кира!"
msgstr "[_Max_s_01_] In bocca al lupo, zia Kira!"

# game/scripts/story_02/kira.rpy:334 #-#-# translate crowdin ev2_008_3c55ecf9:
msgid "[_Kira_s_01_] Ой, Макс, ты почему ещё не спишь?"
msgstr "[_Kira_s_01_] Oh, Max, come mai sei ancora sveglio?"

# game/scripts/story_02/kira.rpy:335 #-#-# translate crowdin ev2_008_51339de1:
msgid "[_Max_s_11_] Тебя решил дождаться."
msgstr "[_Max_s_11_] Ho deciso di aspettarti."

# game/scripts/story_02/kira.rpy:336 #-#-# translate crowdin ev2_008_8fb5d19c:
msgid "[_Kira_s_11_] Правда? Слушай, я сегодня так сильно устала, что хочу просто побыстрее лечь спать."
msgstr "[_Kira_s_11_] Davvero? Senti, oggi sono così stanca che voglio solo andare a dormire il prima possibile."

# game/scripts/story_02/kira.rpy:337 #-#-# translate crowdin ev2_008_7579c2b9:
msgid "[_Max_s_12_] Эх... Тогда отдыхай. Спокойной ночи..."
msgstr "[_Max_s_12_] Eh... Allora riposati. Buonanotte..."

# game/scripts/story_02/kira.rpy:348 #-#-# translate crowdin ev2_005_9d9e6483:
msgid "[_Kira_s_01_] Это я с радостью, Макс... Рассказывай, как ты тут живёшь, как твои дела, что нового?"
msgstr "[_Kira_s_01_] Lo faccio volentieri, Max... Dai, raccontami: come te la passi qui? Come stai? Che c'è di nuovo?"

# game/scripts/story_02/kira.rpy:349 #-#-# translate crowdin ev2_005_2a98dde8:
msgid "[_Max_s_11_] Я... Это... Ухх..."
msgstr "[_Max_s_11_] Io... Ecco... Cioè... Mamma mia..."

# game/scripts/story_02/kira.rpy:350 #-#-# translate crowdin ev2_005_2f12e48e:
msgid "[_Kira_s_11_] Что с тобой, Макс? Всё хорошо?"
msgstr "[_Kira_s_11_] Che ti succede, Max? Tutto bene?"

# game/scripts/story_02/kira.rpy:351 #-#-# translate crowdin ev2_005_24f6aeb7:
msgid "[_Max_s_01_] Да... Я немного залип..."
msgstr "[_Max_s_01_] Sì... Mi sono un attimo incantato..."

# game/scripts/story_02/kira.rpy:352 #-#-# translate crowdin ev2_005_73013fac:
msgid "[_Kira_s_03_] А-а-а... Кажется, я поняла. Надеюсь, мы не насовсем тебя потеряли и ты сможешь найти в себе силы, чтобы смотреть мне в глаза, а не на мою грудь?"
msgstr "[_Kira_s_03_] Ah... Mi sa che ho capito. Spero che non ti abbiamo perso del tutto e che riuscirai a trovare la forza di guardarmi negli occhi, invece che il seno?"

# game/scripts/story_02/kira.rpy:353 #-#-# translate crowdin ev2_005_6e63b78e:
msgid "[_Max_s_04_] Ага..."
msgstr "[_Max_s_04_] Già..."

# game/scripts/story_02/kira.rpy:354 #-#-# translate crowdin ev2_005_08d6fd65:
msgid "[_Kira_s_04_] Ау, Макс, ты здесь? Глаза чуть выше..."
msgstr "[_Kira_s_04_] Ehi, Max, ci sei? Gli occhi un po' più su..."

# game/scripts/story_02/kira.rpy:355 #-#-# translate crowdin ev2_005_22497382:
msgid "[_Max_s_12_] Да! Кажется, я здесь. Извини, тётя Кира..."
msgstr "[_Max_s_12_] Sì! Mi sa che ci sono. Scusa, zia Kira..."

# game/scripts/story_02/kira.rpy:356 #-#-# translate crowdin ev2_005_68bf4624:
msgid "[_Kira_s_02_] Ничего страшного. Подрос ты, однако, у нас. Девочку себе завёл уже?"
msgstr "[_Kira_s_02_] Tranquillo. Ti sei fatto proprio grande, però, eh... Ti sei già trovato una ragazza?"

# game/scripts/story_02/kira.rpy:357 #-#-# translate crowdin ev2_005_73f25b14:
msgid "[_Max_s_14_] Нет, как-то ещё не успел после переезда."
msgstr "[_Max_s_14_] No, non ho ancora fatto in tempo dopo il trasloco."

# game/scripts/story_02/kira.rpy:358 #-#-# translate crowdin ev2_005_16aad2b6:
msgid "[_Kira_s_01_] Ну, это объясняет твоё залипание на мою грудь. Возраст такой у тебя сейчас, гормоны, кругом полуобнажённые девушки и женщины... Наверное, для тебя это каторга? Со мной можешь говорить откровенно. Я никому ни слова!"
msgstr "[_Kira_s_01_] Beh, questo spiega perché ti sei incantato a guardarmi il seno. Alla tua età è normale, hai gli ormoni a mille e sei circondato da ragazze e donne seminude... Dev'essere una vera tortura per te, eh? Con me puoi parlare apertamente. Non dirò una parola a nessuno!"

# game/scripts/story_02/kira.rpy:359 #-#-# translate crowdin ev2_005_0f537c80:
msgid "[_Max_s_12_] Да, бывает возбуждаюсь..."
msgstr "[_Max_s_12_] Sì... Ogni tanto capita che mi eccito..."

# game/scripts/story_02/kira.rpy:360 #-#-# translate crowdin ev2_005_60f4cbaf:
msgid "[_Kira_s_03_] Это потому-что ты пялишься не туда, куда надо. Следует смотреть в глаза..."
msgstr "[_Kira_s_03_] Questo è perché guardi dove non dovresti. Bisogna guardare negli occhi..."

# game/scripts/story_02/kira.rpy:361 #-#-# translate crowdin ev2_005_eedeea2e:
msgid "[_Max_s_11_] Да знаю я. Просто глаза сами съезжают..."
msgstr "[_Max_s_11_] Lo so, lo so... È che gli occhi ci cadono da soli..."

# game/scripts/story_02/kira.rpy:362 #-#-# translate crowdin ev2_005_a5eb3804:
msgid "[_Kira_s_04_] Видимо, тебе и с Лизой непросто сейчас в одной комнате уживаться? Она же сверкает своим нижним бельём или пижамой, да и спите вы рядом."
msgstr "[_Kira_s_04_] A quanto pare dev'essere dura convivere nella stessa stanza anche con Lisa in questo periodo. Va sempre in giro in intimo o in pigiama, e per di più dormite vicini."

# game/scripts/story_02/kira.rpy:363 #-#-# translate crowdin ev2_005_06485a09:
msgid "[_Max_s_01_] Да, у нас там уже всякое было..."
msgstr "[_Max_s_01_] Eh sì... Diciamo che là dentro è già successo di tutto..."

# game/scripts/story_02/kira.rpy:364 #-#-# translate crowdin ev2_005_62be3f26:
msgid "[_Kira_s_06_] Опа, опа! Как же я обожаю такие... пикантные моменты. Сейчас угадаю... Она проснулась, а у тебя стоит?"
msgstr "[_Kira_s_06_] Uh la la! Quanto adoro questi... Dettagli piccanti. Fammi indovinare... Lei si è svegliata e tu ce l'avevi duro?"

# game/scripts/story_02/kira.rpy:365 #-#-# translate crowdin ev2_005_840c1039:
msgid "[_Max_s_02_] Ага, и не раз она так просыпалась."
msgstr "[_Max_s_02_] Già, e si è svegliata così più di una volta."

# game/scripts/story_02/kira.rpy:366 #-#-# translate crowdin ev2_005_d061d10d:
msgid "[_Kira_s_01_] И как она отреагировала?"
msgstr "[_Kira_s_01_] E lei come ha reagito?"

# game/scripts/story_02/kira.rpy:367 #-#-# translate crowdin ev2_005_c550cc07:
msgid "[_Max_s_03_] В первый раз панику подняла, маму позвала! Потом уже легче было, она всё старалась пристыдить меня. Мама же её всё ещё оберегает от всего такого, ничего не рассказывает."
msgstr "[_Max_s_03_] La prima volta è andata nel panico e ha chiamato la mamma! Poi è stato più facile, cercava solo di farmi vergognare. Tanto la mamma la protegge ancora da tutte queste cose, non le racconta mai niente."

# game/scripts/story_02/kira.rpy:368 #-#-# translate crowdin ev2_005_e9735d44:
msgid "[_Kira_s_11_] Да ты что?! Вообще-то давно пора... Но ничего, я с ней побеседую на эту тему. И на многие другие, тоже."
msgstr "[_Kira_s_11_] Ma dai?! A dire il vero sarebbe anche ora... Ma non ti preoccupare, ci penso io a farle un bel discorsetto su questo argomento. E anche su tanti altri."

# game/scripts/story_02/kira.rpy:369 #-#-# translate crowdin ev2_005_1c8a8431:
msgid "[_Max_s_11_] Фух... Наконец-то, хоть кто-то это сделает, а то к моим рассказам она довольно скептически относится."
msgstr "[_Max_s_11_] Fiuu... Finalmente qualcuno che lo fa! Anche perché quando le spiego le cose io, è sempre piuttosto scettica."

# game/scripts/story_02/kira.rpy:370 #-#-# translate crowdin ev2_005_b82c5651:
msgid "[_Kira_s_02_] Но это же не всё? Что у вас там ещё интересненького было, признавайся?"
msgstr "[_Kira_s_02_] Ma scommetto che non è tutto qui! Cos'altro è successo di bello là dentro? Dai, sputa il rospo?"

# game/scripts/story_02/kira.rpy:371 #-#-# translate crowdin ev2_005_8222fb15:
msgid "[_Max_s_04_] Да, так... Целоваться её учил. Только ты об этом никому, хорошо?"
msgstr "[_Max_s_04_] Sì, ecco... Le ho insegnato a baciare. Però tu acqua in bocca con tutti, va bene?"

# game/scripts/story_02/kira.rpy:372 #-#-# translate crowdin ev2_005_b67c941e:
msgid "[_Kira_s_04_] Ого! А ты не промах, Макс! Подожди... У тебя же девушки нет. Как же ты..."
msgstr "[_Kira_s_04_] Ammazza! Ci sai fare, Max! Aspetta un attimo... Ma tu non hai una ragazza. Quindi come fai a..."

# game/scripts/story_02/kira.rpy:373 #-#-# translate crowdin ev2_005_2ae0fa78:
msgid "[_Max_s_12_] Честно говоря, опыта у меня было чуть-чуть, поэтому это только с натяжкой можно было назвать поцелуями."
msgstr "[_Max_s_12_] A dire il vero, avevo pochissima esperienza, quindi chiamarli baci è un parolone."

# game/scripts/story_02/kira.rpy:374 #-#-# translate crowdin ev2_005_f6d79b4d:
msgid "[_Kira_s_03_] Макс, так не годится! Напомни мне как-нибудь потом, я тебя просвещу по этому вопросу с поцелуями. Будешь у меня всех девчонок с ума сводить..."
msgstr "[_Kira_s_03_] Max, così non ci siamo proprio! Ricordamelo più in là, ci penso io a istruirti sulla questione baci. Vedrai che poi farai girare la testa a tutte le ragazze..."

# game/scripts/story_02/kira.rpy:375 #-#-# translate crowdin ev2_005_44201710:
msgid "[_Max_s_05_] Правда?! Было бы здорово, тётя Кира... А насколько потом?"
msgstr "[_Max_s_05_] Davvero?! Sarebbe fantastico, zia Kira... Ma quanto 'più in là?"

# game/scripts/story_02/kira.rpy:376 #-#-# translate crowdin ev2_005_c100c547:
msgid "[_Kira_s_02_] Ну, Макс, я только приехала. Сперва хорошенько отдохну, наберусь сил, с работой ещё нужно будет вопрос решить..."
msgstr "[_Kira_s_02_] Dai, Max, sono appena arrivata! Prima voglio riposarmi per bene e ricaricare le pile, e poi c'è ancora la questione del lavoro da sistemare..."

# game/scripts/story_02/kira.rpy:377 #-#-# translate crowdin ev2_005_acfebd6c:
msgid "[_Max_s_11_] Понял. Тогда отдыхай..."
msgstr "[_Max_s_11_] Capito. Allora riposati..."

# game/scripts/story_02/kira.rpy:387 #-#-# translate crowdin ev2_005_5919b2af:
msgid "[_tMax_s_01_] Наконец-то хоть кто-то поможет мне с поцелуями! Тётя у меня женщина взрослая и наверняка опытная, с такой-то сексуальной внешностью..."
msgstr "[_tMax_s_01_] Finalmente qualcuno che mi darà una mano con i baci! La zia è una donna matura e sicuramente esperta, con quel fisico così sexy..."

# game/scripts/story_02/kira.rpy:388 #-#-# translate crowdin ev2_005_a032babc:
msgid "[_tMax_s_02_] Тётя Кира вообще женщина интересная. С ней стоит побольше общаться... Можно и маслом для загара её попробовать натереть в следующий раз во время общения..."
msgstr "[_tMax_s_02_] Zia Kira è proprio una donna interessante. Vale la pena passarci più tempo insieme... Quasi quasi la prossima volta, mentre chiacchieriamo, provo a spalmarle l'olio abbronzante..."

# game/scripts/story_02/kira.rpy:389 #-#-# translate crowdin ev2_005_4261ba57:
msgid "[_tMax_s_04_] Это было бы весьма приятным занятием!"
msgstr "[_tMax_s_04_] Sarebbe un'attività davvero piacevole!"

# game/scripts/story_02/kira.rpy:400 #-#-# translate crowdin ev2_009_7024ee62:
msgid "[_Kira_s_01_] Да, это было бы очень кстати! Заодно и поболтаем с тобой."
msgstr "[_Kira_s_01_] Sì, sarebbe davvero perfetto! E con l'occasione faremo anche due chiacchiere."

# game/scripts/story_02/kira.rpy:401 #-#-# translate crowdin ev2_009_46ea0828:
msgid "[_Max_s_01_] Ага, поворачивайся ко мне спиной..."
msgstr "[_Max_s_01_] Ecco, girati di schiena..."

# game/scripts/story_02/kira.rpy:405 #-#-# translate crowdin ev2_009_8558d0c1:
msgid "[_Kira_s_02_] Вот уже и сервис начинает тут для меня появляется. Хотя, не только для меня, я думаю?"
msgstr "[_Kira_s_02_] Ma guarda un po', sta iniziando a nascere un servizio su misura per me qui. Anche se non sono l'unico, immagino?"

# game/scripts/story_02/kira.rpy:406 #-#-# translate crowdin ev2_009_da959b00:
msgid "[_Max_s_03_] Да, я закрепился последнее время, как главный по маслу для загара. Все довольны..."
msgstr "[_Max_s_03_] Sì, ultimamente mi sono affermato come il re dell'olio abbronzante. E sono tutti contenti..."

# game/scripts/story_02/kira.rpy:407 #-#-# translate crowdin ev2_009_93bee138:
msgid "[_Kira_s_04_] Но это же не всё, чем ты занимаешься, пока сидишь дома? Не зависаешь же ты на порносайтах весь день в свободное от натирания маслом время?"
msgstr "[_Kira_s_04_] Ma non sarà mica tutto quello che fai mentre te ne stai a casa? Non passerai mica tutto il giorno sui siti porno nel tempo libero tra un'oliata e l'altra?"

# game/scripts/story_02/kira.rpy:408 #-#-# translate crowdin ev2_009_c389e2e6:
msgid "[_Max_s_13_] У нас не работают порносайты..."
msgstr "[_Max_s_13_] Da noi i siti porno sono bloccati..."

# game/scripts/story_02/kira.rpy:413 #-#-# translate crowdin ev2_009_af6d98d5:
msgid "[_Kira_s_11_] Ах вот в чём дело! А я никак не могла понять, что такое с моим телефоном. Это мама установила такие порядки?"
msgstr "[_Kira_s_11_] Ah, ecco cos'era! E io che non riuscivo proprio a capire cosa avesse il mio telefono. È stata la mamma a mettere queste regole?"

# game/scripts/story_02/kira.rpy:414 #-#-# translate crowdin ev2_009_3a02b2c1:
msgid "[_Max_s_16_] Кто же ещё. Защита от детей..."
msgstr "[_Max_s_16_] E chi se no. Il filtro famiglia..."

# game/scripts/story_02/kira.rpy:415 #-#-# translate crowdin ev2_009_a3e00c19:
msgid "[_Kira_s_10_] Да уж... Здесь тебе можно только посочувствовать, Макс. Как же ты... снимешь напряжение без порнушки? Журналы? Или коллекция порнушки на компьютере?"
msgstr "[_Kira_s_10_] Eh già... C'è solo da compatirti, Max. E come fai a... Scaricare la tensione senza porno? Riviste? O hai una collezione sul computer?"

# game/scripts/story_02/kira.rpy:416 #-#-# translate crowdin ev2_009_b43beade:
msgid "[_Max_s_04_] Небольшая коллекция на компьютере есть, но у меня и фантазия богатая."
msgstr "[_Max_s_04_] Una piccola collezione sul computer ce l'ho, ma ho anche una fervida immaginazione."

# game/scripts/story_02/kira.rpy:417 #-#-# translate crowdin ev2_009_50ed66bd:
msgid "[_Kira_s_06_] Ммм... Фантазёр ты у нас, значит. Так, так, так... И о чём фантазируешь?"
msgstr "[_Kira_s_06_] Mmm... Quindi sei un tipo fantasioso, a quanto pare. Bene, bene, bene... E su cosa fantastichi?"

# game/scripts/story_02/kira.rpy:418 #-#-# translate crowdin ev2_009_81ce3a0a:
msgid "[_Max_s_11_] Ну, так... Обо всяком..."
msgstr "[_Max_s_11_] Beh... Un po' di tutto..."

# game/scripts/story_02/kira.rpy:419 #-#-# translate crowdin ev2_009_a0e07e1f:
msgid "[_Kira_s_04_] Фантазии, Макс, это неплохо, но лучше не засиживайся в них, а ищи девушку, с которой будешь воплощать эти фантазии в жизнь."
msgstr "[_Kira_s_04_] Le fantasie non sono male, Max, ma vedi di non perdertici troppo. Piuttosto, trovati una ragazza con cui trasformarle in realtà."

# game/scripts/story_02/kira.rpy:420 #-#-# translate crowdin ev2_009_c73ed648:
msgid "[_Max_s_01_] Обязательно, тётя Кира. Спинку я тебе маслом намазал. Ножки будешь себе натирать?"
msgstr "[_Max_s_01_] Certamente, zia Kira. La schiena te l'ho già oliata. Le gambe te le fai da sola?"

# game/scripts/story_02/kira.rpy:424 #-#-# translate crowdin ev2_009_f0f0901b:
msgid "[_Kira_s_03_] Сама?! Ну уж нет. Кто хвастался, что он главный по маслу, тот и натирает..."
msgstr "[_Kira_s_03_] Da sola?! Ma neanche per sogno. Chi si vantava di essere il re dell'olio, adesso continua a spalmare..."

# game/scripts/story_02/kira.rpy:425 #-#-# translate crowdin ev2_009_8ac8a835:
msgid "[_Max_s_02_] Легко. Один момент..."
msgstr "[_Max_s_02_] Facile. Un attimo..."

# game/scripts/story_02/kira.rpy:430 #-#-# translate crowdin ev2_009_aacda7e3:
msgid "[_Kira_s_02_] Знаешь, Макс, это уже скорее тянет на полноценный массаж. Тебя кто такому научить успел?"
msgstr "[_Kira_s_02_] Sai, Max, questo sembra quasi un massaggio vero e proprio. Chi ti ha già insegnato a farlo?"

# game/scripts/story_02/kira.rpy:431 #-#-# translate crowdin ev2_009_22291391:
msgid "[_Max_s_03_] Онлайн-курсы. И руки из правильного места растут, видимо. А практиковался я на сёстрах и на маме."
msgstr "[_Max_s_03_] Corsi online. E a quanto pare ho una buona manualità. Poi ho fatto pratica con le mie sorelle e con la mamma."

# game/scripts/story_02/kira.rpy:432 #-#-# translate crowdin ev2_009_eeaabde5:
msgid "[_Kira_s_01_] Ммм... Получается, мне повезло попасть уже в более-менее опытные руки. Ты большой молодец, что освоил это."
msgstr "[_Kira_s_01_] Mmm... Allora mi è andata bene a finire in mani già abbastanza esperte. Sei stato bravissimo a impararlo."

# game/scripts/story_02/kira.rpy:433 #-#-# translate crowdin ev2_009_0fa9356b:
msgid "[_Max_s_04_] Можно сказать, что это Алиса меня надоумила. Всегда по вечерам балдеет у ТВ, если я ей массаж ног делаю."
msgstr "[_Max_s_04_] Diciamo che è stata Alice a darmi l'idea. Va sempre in estasi la sera davanti alla TV se le faccio un massaggio ai piedi."

# game/scripts/story_02/kira.rpy:434 #-#-# translate crowdin ev2_009_9ff16320:
msgid "[_Kira_s_04_] Даже так?! Тогда мои ножки полностью в твоём распоряжении, Макс. Можешь делать с ними всё, лишь бы я тоже балдела, как Алиса..."
msgstr "[_Kira_s_04_] Ah, addirittura?! Allora le mie gambe sono completamente a tua disposizione, Max. Puoi farci tutto quello che vuoi, basta che vada in estasi anch'io come Alice..."

# game/scripts/story_02/kira.rpy:435 #-#-# translate crowdin ev2_009_57c7e633:
msgid "[_Max_s_05_] Ого! Ладно, сейчас попробую..."
msgstr "[_Max_s_05_] Wow! Va bene, adesso ci provo..."

# game/scripts/story_02/kira.rpy:439 #-#-# translate crowdin ev2_009_da48c19c:
msgid "[_Kira_s_05_] Ухх... Я и не думала, что находиться у вас в гостях будет настолько приятно! Даже не думай останавливаться."
msgstr "[_Kira_s_05_] Mmm... Non avrei mai pensato che stare da voi sarebbe stato così piacevole! Non ci pensare nemmeno a fermarti."

# game/scripts/story_02/kira.rpy:440 #-#-# translate crowdin ev2_009_0bf0382f:
msgid "[_Max_s_04_] Ещё рано."
msgstr "[_Max_s_04_] È ancora presto."

# game/scripts/story_02/kira.rpy:444 #-#-# translate crowdin ev2_009_40a51359:
msgid "[_tMax_s_06_] Блин, после таких фраз тётю хочется натереть маслом абсолютно везде! А кое-где я бы особенно хотел задержаться своими руками..."
msgstr "[_tMax_s_06_] Cavolo, dopo certe frasi viene proprio voglia di spalmare l'olio su mia zia dappertutto! E in certi punti vorrei proprio soffermarmi con le mie mani..."

# game/scripts/story_02/kira.rpy:445 #-#-# translate crowdin ev2_009_50b5821c:
msgid "[_Kira_s_12_] Вау! Да я смотрю твой рост пошёл куда надо, Макс!"
msgstr "[_Kira_s_12_] Uau! A quanto pare stai crescendo proprio dove serve, Max!"

# game/scripts/story_02/kira.rpy:446 #-#-# translate crowdin ev2_009_63f26755:
msgid "[_Max_s_07_] А? Что?"
msgstr "[_Max_s_07_] Eh? Cosa?"

# game/scripts/story_02/kira.rpy:450 #-#-# translate crowdin ev2_009_1d3c3aef:
msgid "[_Kira_s_04_] Это ты так перевозбудился из-за моего не особо скромного купальника? Или от моих пошловатых высказываний?"
msgstr "[_Kira_s_04_] Ti sei eccitato così tanto per via del mio costume non proprio modesto? O per le mie battute un po' spinte?"

# game/scripts/story_02/kira.rpy:451 #-#-# translate crowdin ev2_009_93b7330c:
msgid "[_Max_s_11_] Даже не знаю. Наверно, от всего вместе."
msgstr "[_Max_s_11_] Non saprei proprio. Forse per entrambe le cose insieme."

# game/scripts/story_02/kira.rpy:452 #-#-# translate crowdin ev2_009_906875b3:
msgid "[_Kira_s_11_] Если честно, то я обычно загораю голая... Ой, мне бы следовало быть тактичнее, да? Обычно я не слежу за языком, но с детьми надо быть... Хотя, ты уже совсем не ребёнок, как я вижу."
msgstr "[_Kira_s_11_] A dire il vero, di solito prendo il sole nuda... Ops, forse avrei dovuto avere più tatto, vero? Di solito non ho molti filtri, ma con i ragazzini bisognerebbe... Anche se, da quel che vedo, ormai non sei proprio più un bambino."

# game/scripts/story_02/kira.rpy:453 #-#-# translate crowdin ev2_009_9d459a14:
msgid "[_Max_s_04_] Верно подмечено."
msgstr "[_Max_s_04_] Ottima osservazione."

# game/scripts/story_02/kira.rpy:454 #-#-# translate crowdin ev2_009_db78d22a:
msgid "[_Kira_s_03_] Тебе бы стоило пойти и... выпустить пар, так сказать. Не терпи, я всё понимаю."
msgstr "[_Kira_s_03_] Dovresti andare a... Sfogarti, per così dire. Non trattenerti, ti capisco perfettamente."

# game/scripts/story_02/kira.rpy:455 #-#-# translate crowdin ev2_009_e3f40b86:
msgid "[_Max_s_01_] Да, пойду-ка я схожу душ приму..."
msgstr "[_Max_s_01_] Sì, quasi quasi vado a farmi una doccia..."

# game/scripts/story_02/kira.rpy:456 #-#-# translate crowdin ev2_009_3221664b:
msgid "[_Kira_s_02_] Вот это будет самое то."
msgstr "[_Kira_s_02_] Ecco, questo sì che sarebbe l'ideale."

# game/scripts/story_02/kira.rpy:460 #-#-# translate crowdin ev2_009_fa27c7f9:
msgid "[_tMax_s_11_] Да уж... Купальник у тёти Киры, конечно, провокационный на все 10 из 10. Стояк сейчас такой, что аж ходить тяжело."
msgstr "[_tMax_s_11_] Mamma mia... Il costume di zia Kira è decisamente provocante, un 10 su 10 pieno. Ho un'erezione tale che faccio persino fatica a camminare."

# game/scripts/story_02/kira.rpy:461 #-#-# translate crowdin ev2_009_86eae70a:
msgid "[_tMax_s_04_] Приятно, что появилась женщина, которая всё понимает и не истерит от того, что у меня на неё стоит. А то некоторые тут начинают сразу..."
msgstr "[_tMax_s_04_] Fa piacere che sia arrivata una donna che capisce come vanno le cose e non sclera per il fatto che ce l'ho duro per lei. Non come certe che iniziano subito a..."

# game/scripts/story_02/kira.rpy:468 #-#-# translate crowdin ev2_009_7ff36b5c:
msgid "[_tMax_s_01_] А вот Кира... Это определённо та женщина, которая прекрасно знает, насколько она горяча и сексуальна..."
msgstr "[_tMax_s_01_] E poi c'è Kira... È decisamente una donna che sa benissimo quanto sia sexy e sensuale..."

# game/scripts/story_02/kira.rpy:469 #-#-# translate crowdin ev2_009_15257ab5:
msgid "[_tMax_s_07_] Хочется только одного и неважно, что она моя родная тётя!"
msgstr "[_tMax_s_07_] Voglio solo una cosa, e non importa che sia mia zia!"

# game/scripts/story_02/kira.rpy:474 #-#-# translate crowdin ev2_009_290e8469:
msgid "[_tMax_s_06_] Загнать в неё член и трахать! Уж не знаю, каково это, но думаю, что обалденно приятно... О да! И пожёстче..."
msgstr "[_tMax_s_06_] Ficcarle il cazzo dentro e scoparla! Non so come sia, ma penso sia una goduria pazzesca... Oh sì! E più forte..."

# game/scripts/story_02/kira.rpy:475 #-#-# translate crowdin ev2_009_2c6707f1:
msgid "[_tMax_s_08_] Чтобы её стоны были слышны на всю улицу! Ох, блин, как же я сейчас мощно кончу..."
msgstr "[_tMax_s_08_] Da far sentire i suoi gemiti per tutta la strada! Oh, cazzo, come sto per venire forte adesso..."

# game/scripts/story_02/kira.rpy:479 #-#-# translate crowdin ev2_009_f2315fda:
msgid "[_tMax_s_09_] Д-а-а... Прямо на её похотливое и довольное личико! Ну не красотища ли, когда женщина вся забрызгана твоей спермой?!"
msgstr "[_tMax_s_09_] S-ì-ì... Proprio sulla sua faccina vogliosa e soddisfatta! Non è uno spettacolo pazzesco quando una donna è tutta schizzata del tuo sperma?!"

# game/scripts/story_02/kira.rpy:484 #-#-# translate crowdin ev2_009_592d952f:
msgid "[_Kira_s_04_] Что, прости? Я не расслышала последнее..."
msgstr "[_Kira_s_04_] Come, scusa? Non ho sentito bene l'ultima cosa..."

# game/scripts/story_02/kira.rpy:485 #-#-# translate crowdin ev2_009_a716992b:
msgid "[_Max_s_15_] Вот чёрт! Тётя Кира, я думал, ты лежишь загораешь..."
msgstr "[_Max_s_15_] Oh cavolo! Zia Kira, pensavo che fossi sdraiata a prendere il sole..."

# game/scripts/story_02/kira.rpy:486 #-#-# translate crowdin ev2_009_41f1a871:
msgid "[_Kira_s_02_] Да, но я решила подойти, проверить, как ты тут... справляешься. Я же всё-таки несколько виновата в твоём... напряжении."
msgstr "[_Kira_s_02_] Sì, ma ho deciso di venire a vedere come... Te la cavi qua. Dopotutto, è un po' colpa mia per la tua... Tensione."

# game/scripts/story_02/kira.rpy:487 #-#-# translate crowdin ev2_009_8b766a26:
msgid "[_Max_s_14_] Надо было сказать, что ты тут!"
msgstr "[_Max_s_14_] Avresti dovuto dirmi che eri qui!"

# game/scripts/story_02/kira.rpy:488 #-#-# translate crowdin ev2_009_ee239164:
msgid "[_Kira_s_03_] Не хотелось тебя отвлекать. И ещё хотела сказать, что сегодня ночью я должна вернуться не сильно уставшая. Если вдруг ещё не будешь спать, то приходи ко мне в гостиную. Что-нибудь посмотрим вместе..."
msgstr "[_Kira_s_03_] Non volevo distrarti. E volevo anche dirti che stanotte dovrei tornare non troppo stanca. Se per caso non dormi ancora, vieni da me in salotto. Guardiamo qualcosa insieme..."

# game/scripts/story_02/kira.rpy:489 #-#-# translate crowdin ev2_009_d9d89dc5:
msgid "[_Max_s_12_] О, круто! Только вот момент для того, чтобы это сказать, ты выбрала «самый» подходящий."
msgstr "[_Max_s_12_] Oh, figo! Però hai scelto proprio il momento «migliore» per dirmelo."

# game/scripts/story_02/kira.rpy:490 #-#-# translate crowdin ev2_009_78d70481:
msgid "[_Kira_s_04_] Да, извиняюсь, хи-хи... Должно быть, я тебя немного застесняла. Ухожу..."
msgstr "[_Kira_s_04_] Sì, scusa, ihih... Ti avrò messo un po' in imbarazzo. Me ne vado..."

# game/scripts/story_02/kira.rpy:494 #-#-# translate crowdin ev2_009_281df843:
msgid "[_tMax_s_16_] Фух... Ничего себе картина. И с какого момента, интересно, она тут стояла?! Неужели я ещё и вслух что-то говорил?"
msgstr "[_tMax_s_16_] Fiù... Che scena. E da quanto tempo stava qui, mi chiedo?! Vuoi vedere che ho pure detto qualcosa ad alta voce?"

# game/scripts/story_02/kira.rpy:495 #-#-# translate crowdin ev2_009_66e163b3:
msgid "[_tMax_s_13_] Вопросов куча, ответов нет! Но если бы её что-то смутило, то она бы не звала меня ночью к себе..."
msgstr "[_tMax_s_13_] Un sacco di domande, zero risposte! Ma se qualcosa l'avesse messa a disagio, non mi avrebbe invitato da lei stanotte..."

# game/scripts/story_02/kira.rpy:496 #-#-# translate crowdin ev2_009_efa3355b:
msgid "[_tMax_s_12_] Получается, всё нормально. Хотя, если подумать, то всю эту ситуацию во дворе и душе точно нормальной назвать нельзя."
msgstr "[_tMax_s_12_] Quindi è tutto a posto. Anche se, a pensarci bene, tutta questa situazione nel cortile e nella doccia non si può proprio definire normale."

# game/scripts/story_02/kira.rpy:497 #-#-# translate crowdin ev2_009_654807fb:
msgid "[_tMax_s_11_] Ладно... Потусуюсь ночью с Кирой, там и станет ясно, насколько это всё было нормально..."
msgstr "[_tMax_s_11_] Vabbè... Stanotte starò un po' con Kira, e lì si vedrà quanto tutto questo fosse normale..."

# game/scripts/story_02/kira.rpy:515 #-#-# translate crowdin ev2_010_3c55ecf9:
msgid "[_Kira_s_01_] Ой, Макс, ты почему ещё не спишь?"
msgstr "[_Kira_s_01_] Oh, Max, come mai sei ancora sveglio?"

# game/scripts/story_02/kira.rpy:516 #-#-# translate crowdin ev2_010_c4480125:
msgid "[_Max_s_11_] Тебя решил дождаться. Сама же звала..."
msgstr "[_Max_s_11_] Ho deciso di aspettarti. Sei stata tu a invitarmi..."

# game/scripts/story_02/kira.rpy:517 #-#-# translate crowdin ev2_010_74478bb7:
msgid "[_Kira_s_02_] Тогда подожди меня ещё немного, я переоденусь. Я там подцепила к вашему проектору свой диск с фильмами. Можешь поизучать, пока я отсутствую. Найдёшь что-то интересное - включай!"
msgstr "[_Kira_s_02_] Allora aspettami ancora un po', vado a cambiarmi. Ho attaccato il mio disco con i film al vostro proiettore. Dacci pure un'occhiata mentre non ci sono. Se trovi qualcosa d'interessante, fallo partire!"

# game/scripts/story_02/kira.rpy:518 #-#-# translate crowdin ev2_010_8c03e541:
msgid "[_Max_s_02_] Отлично! Сейчас посмотрю, что там у тебя есть..."
msgstr "[_Max_s_02_] Perfetto! Ora guardo un po' cosa c'è..."

# game/scripts/story_02/kira.rpy:522 #-#-# translate crowdin ev2_010_02b5829b:
msgid "[_tMax_s_03_] Ага, вот и фильмы... У тёти Киры есть из чего повыбирать. Некоторые мне даже знакомы..."
msgstr "[_tMax_s_03_] Ah, ecco i film... Zia Kira ha un bel po' di scelta. Alcuni li conosco pure..."

# game/scripts/story_02/kira.rpy:523 #-#-# translate crowdin ev2_010_968e9098:
msgid "[_tMax_s_13_] Хм... Интересно, а что это за папка такая, «Взрослое»? Эротика что ли? Ну-ка, ну-ка, надо включить..."
msgstr "[_tMax_s_13_] Uhm... Chissà cos'è questa cartella, «Per adulti»? Sarà mica roba erotica? Vediamo, vediamo, devo farla partire..."

# game/scripts/story_02/kira.rpy:527 #-#-# translate crowdin ev2_010_e832fc75:
msgid "[_tMax_s_05_] Ого, да это скорее порнушка! О-ля-ля... Ещё и весьма качественная, судя по картинке! Так, а по содержанию что?"
msgstr "[_tMax_s_05_] Caspita, ma questa è roba porno! Ulalà... E anche di alta qualità, a giudicare dal video! Ok, vediamo un po' la trama?"

# game/scripts/story_02/kira.rpy:531 #-#-# translate crowdin ev2_010_0ba4ab3d:
msgid "[_tMax_s_04_] Похоже, что у меня теперь появится новое занятие перед сном. Главное, чтобы меня никто за этим делом не застукал..."
msgstr "[_tMax_s_04_] Sembra proprio che adesso avrò un nuovo passatempo prima di dormire. L'importante è che nessuno mi becchi a farlo..."

# game/scripts/story_02/kira.rpy:535 #-#-# translate crowdin ev2_010_e44f1599:
msgid "[_Kira_s_04_] Я смотрю, ты нашёл для себя кое-что интересное немного не в той папке, Макс."
msgstr "[_Kira_s_04_] A quanto vedo hai trovato qualcosa d'interessante, ma nella cartella sbagliata, Max."

# game/scripts/story_02/kira.rpy:536 #-#-# translate crowdin ev2_010_e1323011:
msgid "[_Max_s_12_] Ой! Я... это... Оно само как-то нажалось..."
msgstr "[_Max_s_12_] Ops! Io... ecco... Si è cliccato da solo in qualche modo..."

# game/scripts/story_02/kira.rpy:537 #-#-# translate crowdin ev2_010_e9c5b8c1:
msgid "[_Kira_s_03_] Запутался в кнопках на пульте, да? У меня такое часто бывает."
msgstr "[_Kira_s_03_] Ti sei confuso con i tasti del telecomando, vero? Capita spesso anche a me."

# game/scripts/story_02/kira.rpy:538 #-#-# translate crowdin ev2_010_6ec747ce:
msgid "[_Max_s_11_] Классный у тебя халатик, тётя Кира! Прямо под цвет глаз."
msgstr "[_Max_s_11_] Che bella la tua vestaglia, zia Kira! Si abbina perfettamente al colore dei tuoi occhi."

# game/scripts/story_02/kira.rpy:542 #-#-# translate crowdin ev2_010_695218d4:
msgid "[_Kira_s_02_] Спасибо! Зная, как ты реагируешь на некоторых полуголых и крайне сексуальных женщин, я решила накинуть на себя побольше одежды, чтобы мы спокойно могли что-то посмотреть..."
msgstr "[_Kira_s_02_] Grazie! Sapendo come reagisci davanti a certe donne seminude ed estremamente sexy, ho deciso di mettermi più vestiti addosso, così possiamo guardarci qualcosa tranquillamente..."

# game/scripts/story_02/kira.rpy:543 #-#-# translate crowdin ev2_010_fe87caf8:
msgid "[_Max_s_01_] Ну... Мы всё ещё можем..."
msgstr "[_Max_s_01_] Beh... possiamo ancora..."

# game/scripts/story_02/kira.rpy:544 #-#-# translate crowdin ev2_010_0c8cef23:
msgid "[_Kira_s_01_] Думаешь? Учитывая, что с пультом мы с тобой не в ладах, то лучше смотреть это. Конечно, если ты достаточно взрослый для такого... кино?"
msgstr "[_Kira_s_01_] Dici? Visto che io e te non andiamo molto d'accordo con il telecomando, è meglio guardare questo. Certo, sempre che tu sia abbastanza grande per un... Film del genere?"

# game/scripts/story_02/kira.rpy:545 #-#-# translate crowdin ev2_010_b5a3644a:
msgid "[_Max_s_03_] Тётя Кира, о чём ты вообще говоришь? Я уже даже с мамой эротику смотрел!"
msgstr "[_Max_s_03_] Zia Kira, ma di cosa stai parlando? Ho già visto film erotici persino con mia mamma!"

# game/scripts/story_02/kira.rpy:549 #-#-# translate crowdin ev2_010_d919974f:
msgid "[_Kira_s_12_] Ого, вот это новость! Даже не представляю, как тебе удалось уговорить её на это."
msgstr "[_Kira_s_12_] Caspita, questa sì che è una novità! Non riesco nemmeno a immaginare come tu sia riuscito a convincerla."

# game/scripts/story_02/kira.rpy:550 #-#-# translate crowdin ev2_010_365bb76a:
msgid "[_Max_s_02_] Не пришлось. Она просто не знала, что это эротика, пока не дошло до этого самого."
msgstr "[_Max_s_02_] Non c'è stato bisogno. Lei semplicemente non sapeva che fosse un film erotico, finché non si è arrivati a quello."

# game/scripts/story_02/kira.rpy:554 #-#-# translate crowdin ev2_010_9859b884:
msgid "[_Kira_s_04_] Хитро... И как, получилось у вас досмотреть то кино без явного возбуждения?"
msgstr "[_Kira_s_04_] Furbo... E com'è andata, siete riusciti a finire di vedere quel film senza un'evidente eccitazione?"

# game/scripts/story_02/kira.rpy:555 #-#-# translate crowdin ev2_010_75ef7a0f:
msgid "[_Max_s_04_] На то это и эротика."
msgstr "[_Max_s_04_] Per questo si chiama film erotico."

# game/scripts/story_02/kira.rpy:559 #-#-# translate crowdin ev2_010_e58cfcaf:
msgid "[_Kira_s_06_] Но вот порнушка, Макс, это не то, что можно просто взять и посмотреть. Я обычно под такое начинаю к себе прикасаться и думаю, ты знаешь как и зачем..."
msgstr "[_Kira_s_06_] Ma il porno, Max, non è qualcosa che si può semplicemente mettersi lì a guardare. Di solito, con cose del genere, inizio a toccarmi, e penso che tu sappia come e perché..."

# game/scripts/story_02/kira.rpy:560 #-#-# translate crowdin ev2_010_3f259372:
msgid "[_Max_s_05_] Само собой."
msgstr "[_Max_s_05_] Ovvio."

# game/scripts/story_02/kira.rpy:564 #-#-# translate crowdin ev2_010_683c4f81:
msgid "[_Kira_s_03_] Ну, и халатик я пожалуй сниму, если ты не против? Жарковато же всё-таки..."
msgstr "[_Kira_s_03_] Beh, quasi quasi mi tolgo la vestaglia, se non ti dispiace... Dopotutto fa un po' calduccio..."

# game/scripts/story_02/kira.rpy:565 #-#-# translate crowdin ev2_010_e85d275d:
msgid "[_Max_s_03_] Да без проблем, делай всё, что хочешь!"
msgstr "[_Max_s_03_] Ma nessun problema, fai pure tutto quello che vuoi!"

# game/scripts/story_02/kira.rpy:569 #-#-# translate crowdin ev2_010_34644be5:
msgid "[_Kira_s_01_] Вот теперь, наконец-то, можно отдохнуть и насладиться просмотром..."
msgstr "[_Kira_s_01_] Ecco, adesso sì che finalmente ci si può rilassare e godersi lo spettacolo..."

# game/scripts/story_02/kira.rpy:570 #-#-# translate crowdin ev2_010_99cbd384:
msgid "[_tMax_s_06_] С ума можно сойти! Я мало того, что смотрю порно на большом экране в собственной гостиной, так ещё и вместе с тётей!"
msgstr "[_tMax_s_06_] Roba da matti! Non bastasse il fatto che sto guardando un porno sul maxischermo in salotto, lo sto pure facendo insieme a mia zia!"

# game/scripts/story_02/kira.rpy:571 #-#-# translate crowdin ev2_010_067107c3:
msgid "[_tMax_s_04_] Хоть всё самое интересное у неё и скрыто этим чёрным кружевом, но всё равно, смотреть на неё даже немного интереснее, чем на экран. А уж член-то как просится наружу от всего этого..."
msgstr "[_tMax_s_04_] Anche se le cose più interessanti sono nascoste da quel pizzo nero, guardarla è comunque un po' più interessante che guardare lo schermo. E il mio cazzo spinge da matti per uscire fuori da tutto questo..."

# game/scripts/story_02/kira.rpy:576 #-#-# translate crowdin ev2_010_e780acaa:
msgid "[_Kira_s_02_] Макс, тебе там в шортах не тесно, случаем? Мы с тобой смотрим порно, а ты прикрываешься... Неужели стесняешься? Я ведь уже всё видела..."
msgstr "[_Kira_s_02_] Max, non ti stanno un po' stretti quei pantaloncini, per caso? Stiamo guardando un porno insieme e tu ti copri... Non mi dirai che ti imbarazzi? Tanto ho già visto tutto..."

# game/scripts/story_02/kira.rpy:578 #-#-# translate crowdin ev2_010_52d10b6c:
msgid "[_Kira_s_02_] Макс, тебе там в трусах не тесно, случаем? Мы с тобой смотрим порно, а ты прикрываешься... Неужели стесняешься? Я ведь уже всё видела..."
msgstr "[_Kira_s_02_] Max, non ti stanno un po' stretti quei boxer, per caso? Guardiamo un porno insieme e cerchi pure di coprirti... Ti stai imbarazzando sul serio? Tanto ho già visto tutto..."

# game/scripts/story_02/kira.rpy:579 #-#-# translate crowdin ev2_010_7b23a34a:
msgid "[_Max_s_01_] Вот именно! А вот я не видел. Так что ты первая..."
msgstr "[_Max_s_01_] Appunto! Io invece no. Quindi prima tu..."

# game/scripts/story_02/kira.rpy:580 #-#-# translate crowdin ev2_010_c1cd91cf:
msgid "[_Kira_s_04_] Ммм... Ты на что такое свою родную тётю уговариваешь?! Тебе не кажется, что это слишком для нашего первого совместного просмотра порно?"
msgstr "[_Kira_s_04_] Mmm... Ma cosa vuoi far fare alla tua cara zia?! Non ti pare di esagerare un po' per la nostra prima volta che guardiamo un porno insieme?"

# game/scripts/story_02/kira.rpy:581 #-#-# translate crowdin ev2_010_6744f21a:
msgid "[_Max_s_11_] То есть, без шансов?"
msgstr "[_Max_s_11_] Quindi, nessuna possibilità?"

# game/scripts/story_02/kira.rpy:582 #-#-# translate crowdin ev2_010_b3ec31e7:
msgid "[_Kira_s_03_] Хм... Как знать, Макс. Конечно, может быть так, что этот просмотр настолько меня взволнует, что я совсем потеряю голову. Так что всё в твоих руках, так сказать..."
msgstr "[_Kira_s_03_] Mmh... Chissà, Max. Certo, potrebbe anche essere che questa visione mi ecciti così tanto da farmi perdere completamente la testa. Quindi è tutto nelle tue mani, per così dire..."

# game/scripts/story_02/kira.rpy:583 #-#-# translate crowdin ev2_010_89277ffc:
msgid "[_Max_s_05_] Меня можно и не уговаривать..."
msgstr "[_Max_s_05_] Non serve mica convincermi..."

# game/scripts/story_02/kira.rpy:587 #-#-# translate crowdin ev2_010_c3c41f06:
msgid "[_Kira_s_06_] Ну вот, эта ночка начинает становиться куда интереснее! Так непривычно, что он у тебя уже такой... большой..."
msgstr "[_Kira_s_06_] Bene bene, questa nottata inizia a farsi decisamente più interessante! Fa così strano che sia già così... Grande..."

# game/scripts/story_02/kira.rpy:588 #-#-# translate crowdin ev2_010_fa76f2ee:
msgid "[_Max_s_01_] Это же неплохо, да?"
msgstr "[_Max_s_01_] Non è mica male, vero?"

# game/scripts/story_02/kira.rpy:589 #-#-# translate crowdin ev2_010_54dcefb4:
msgid "[_Kira_s_04_] Хи-хи... Ещё бы! Лично мне это очень нравится... Ой, что это я говорю! Ты меня не слушай, лучше смотри на экран, а то пропустишь всё самое интересное..."
msgstr "[_Kira_s_04_] Ih ih... Altroché! A me personalmente piace un sacco... Oh, ma che sto dicendo! Non darmi retta, meglio se guardi lo schermo, altrimenti ti perdi il meglio..."

# game/scripts/story_02/kira.rpy:590 #-#-# translate crowdin ev2_010_9d503c77:
msgid "[_Max_s_04_] А если мне нравится смотреть на тебя?"
msgstr "[_Max_s_04_] E se mi piacesse guardarti?"

# game/scripts/story_02/kira.rpy:594 #-#-# translate crowdin ev2_010_f4eb7465:
msgid "[_Kira_s_06_] Ох, как же приятно... такое слышать... И мне бы, по-хорошему, следовало тебя пристыдить, но увы... твоя тётя жуткая развратница, Макс!"
msgstr "[_Kira_s_06_] Oh, fa così piacere... Sentirselo dire... E, a dire il vero, dovrei farti la morale, ma ahimè... Tua zia è una perversa pazzesca, Max!"

# game/scripts/story_02/kira.rpy:595 #-#-# translate crowdin ev2_010_9a870eee:
msgid "[_Max_s_09_] Ухх... Я только рад, что ты именно такая..."
msgstr "[_Max_s_09_] Uhh... sono semplicemente contento che tu sia esattamente così..."

# game/scripts/story_02/kira.rpy:596 #-#-# translate crowdin ev2_010_6b32355c:
msgid "[_Kira_s_07_] О да! Здорово, что мы с тобой... Ммм... На одной волне... Ах-х-х! Д-а-а..."
msgstr ""

# game/scripts/story_02/kira.rpy:597 #-#-# translate crowdin ev2_010_d310f5e6:
msgid "[_tMax_s_10_] С ума сойти... Я дрочу на глазах у своей тёти, пока она ласкает свою грудь и киску! Чёрт, да я сейчас кончу от такого..."
msgstr ""

# game/scripts/story_02/kira.rpy:601 #-#-# translate crowdin ev2_010_796b1868:
msgid "[_Kira_s_04_] Ого, ты уже всё?! Быстренько... Молодец, что не забрызгал мне весь диван. Давай, беги к себе в комнату, а то спать уже давно пора."
msgstr ""

# game/scripts/story_02/kira.rpy:602 #-#-# translate crowdin ev2_010_909004fe:
msgid "[_Max_s_11_] А ты?"
msgstr ""

# game/scripts/story_02/kira.rpy:606 #-#-# translate crowdin ev2_010_64150531:
msgid "[_Kira_s_03_] Ну, думаю, я тоже скоро... закончу... и буду спать."
msgstr ""

# game/scripts/story_02/kira.rpy:607 #-#-# translate crowdin ev2_010_45f929f6:
msgid "[_Max_s_02_] Завтра посмотрим что-нибудь ещё?"
msgstr ""

# game/scripts/story_02/kira.rpy:608 #-#-# translate crowdin ev2_010_f5938088:
msgid "[_Kira_s_02_] Может быть... Но знаешь, лучше с этим не частить, хорошо? А то весь интерес потеряется."
msgstr ""

# game/scripts/story_02/kira.rpy:609 #-#-# translate crowdin ev2_010_72037222:
msgid "[_Max_s_01_] Хорошо, тётя Кира. Тогда спокойной ночи."
msgstr ""

# game/scripts/story_02/kira.rpy:611 #-#-# translate crowdin ev2_010_86b7ab6f:
msgid "[_Kira_s_01_] И тебе, Макс. Только чур, не подглядывать за мной. Давай, до завтра... [nointeract]"
msgstr ""

# game/scripts/story_02/kira.rpy:617 #-#-# translate crowdin ev2_010_0353afaf:
msgid "[_tMax_s_04_] Да уж... До сих пор не вериться в то, что сейчас было! Повезло мне с тётей..."
msgstr ""

# game/scripts/story_02/kira.rpy:621 #-#-# translate crowdin ev2_010_a07e1f6c:
msgid "[_tMax_s_02_] А подсмотреть-то хочется... Но сделаю я это, пожалуй, через скрытую камеру, чтобы уж точно ничем ей не помешать..."
msgstr ""

# game/scripts/story_02/kira.rpy:625 #-#-# translate crowdin ev2_010_c328294f:
msgid "[_tMax_s_05_] Эх... Вот продержался бы я хоть немного дольше и, возможно, наблюдал бы сейчас это сидя рядом с ней."
msgstr ""

# game/scripts/story_02/kira.rpy:626 #-#-# translate crowdin ev2_010_e04e23a5:
msgid "[_tMax_s_11_] В следующий раз нужно будет как-то умудриться до такой степени не перевозбудиться. Уж очень интересно, насколько сильно тётя Кира может потерять голову."
msgstr ""

# game/scripts/story_02/kira.rpy:630 #-#-# translate crowdin ev2_010_db50267f:
msgid "[_tMax_s_13_] Но это будет уже в следующем обновлении, v0.12. Опять ждать..."
msgstr ""

