# TODO: Translation updated at 2026-06-22 22:36 #|#|# # game/scripts/story_02/bathroom.rpy:10 #-#-# translate crowdin ev_kira_shower_1f002705:
msgid "[_tMax_s_11_] Сейчас ванная комната должна быть занята тётей Кирой... [nointeract]"
msgstr "[_tMax_s_11_] Adesso in bagno ci dovrebbe essere la zia Kira... [nointeract]"

# game/scripts/story_02/bathroom.rpy:39 #-#-# translate crowdin ev_kira_shower_voy_01_88e80182:
msgid "[_tMax_s_13_] Тёти Киры не видно... Наверно, она ещё раздевается перед тем, как принять душ... [nointeract]"
msgstr "[_tMax_s_13_] La zia Kira non si vede... Probabilmente si sta ancora spogliando prima di entrare in doccia... [nointeract]"

# game/scripts/story_02/bathroom.rpy:59 #-#-# translate crowdin ev_kira_shower_voy_02_11c5067d:
msgid "[_tMax_s_03_] О да! А вот и моя голенькая тётя... Её обалденная попка гипнотизирует так, что оторвать взгляд невозможно... [nointeract]"
msgstr "[_tMax_s_03_] Oh sì! Eccola qui la mia zietta tutta nuda... Il suo sedere pazzesco mi ipnotizza a tal punto che è impossibile staccarle gli occhi di dosso... [nointeract]"

# game/scripts/story_02/bathroom.rpy:71 #-#-# translate crowdin ev_kira_shower_voy_02_c8d99d55:
msgid "[_tMax_s_15_] Упс... Надо бежать, пока тётя Кира меня не увидела, а то уж больно опасно она повернулась! [nointeract]"
msgstr "[_tMax_s_15_] Ops... Meglio scappare prima che la zia Kira mi veda, si è girata in un modo decisamente troppo pericoloso! [nointeract]"

# game/scripts/story_02/bathroom.rpy:90 #-#-# translate crowdin ev_kira_shower_voy_03_a4e21780:
msgid "[_tMax_s_05_] Ухх... Наблюдать за моей тётей просто загляденье! Её округлости и изящность движений так возбуждают... [nointeract]"
msgstr "[_tMax_s_05_] Uhh... Osservare mia zia è un vero spettacolo! Le sue curve e l'eleganza dei suoi movimenti sono così eccitanti... [nointeract]"

# game/scripts/story_02/bathroom.rpy:107 #-#-# translate crowdin ev_kira_shower_caught_2a006023:
msgid "[_Kira_s_13_] Ой, Макс! Я, конечно, всё понимаю... С такими большими окнами я как на показ душ принимаю, но хотя бы для приличия-то надо отворачиваться! [nointeract]"
msgstr "[_Kira_s_13_] Oh, Max! Io capisco tutto, per carità... Con delle finestre così grandi è come se facessi la doccia in vetrina, ma almeno per decenza dovresti voltarti! [nointeract]"

# game/scripts/story_02/bathroom.rpy:124 #-#-# translate crowdin ev_kira_shower_voy_04_378f13cd:
msgid "[_tMax_s_04_] Вот и всё, она уже вытирается... Но напоследок ещё можно успеть насладиться видом её шикарных мокрых сисечек... [nointeract]"
msgstr "[_tMax_s_04_] Ecco fatto, si sta già asciugando... Ma un'ultima volta si fa ancora in tempo a godersi la vista delle sue splendide tette bagnate... [nointeract]"

# game/scripts/story_02/bathroom.rpy:134 #-#-# translate crowdin ev_kira_shower_voy_04_c8d99d55:
msgid "[_tMax_s_15_] Упс... Надо бежать, пока тётя Кира меня не увидела, а то уж больно опасно она повернулась! [nointeract]"
msgstr "[_tMax_s_15_] Ops... Meglio scappare prima che la zia Kira mi veda, si è girata in un modo decisamente troppo pericoloso! [nointeract]"

# game/scripts/story_02/bathroom.rpy:144 #-#-# translate crowdin ev_kira_shower_cooldown_5d695dfe:
msgid "[_tMax_s_12_] Тётя Кира совсем недавно уже ловила меня, когда я подглядывал за ней. Лучше не рисковать лишний раз и подождать хотя бы несколько дней..."
msgstr "[_tMax_s_12_] Zia Kira mi ha già beccato proprio di recente mentre la spiavo. Meglio non rischiare inutilmente e aspettare almeno qualche giorno..."

# game/scripts/story_02/bathroom.rpy:146 #-#-# translate crowdin ev_kira_shower_cooldown_b805e846:
msgid "[_tMax_s_12_] Тётя Кира совсем недавно уже ловила меня, когда я подглядывал за ней. Лучше не рисковать лишний раз и подождать хотя бы ещё денёк..."
msgstr "[_tMax_s_12_] Zia Kira mi ha già beccato da poco mentre la spiavo. Meglio non rischiare inutilmente e aspettare almeno un altro giorno..."

# game/scripts/story_02/bathroom.rpy:166 #-#-# translate crowdin ev_kira_shower_ladder_01_1d136386:
msgid "[_tMax_s_01_] Посмотрим, что она там делает..."
msgstr "[_tMax_s_01_] Vediamo cosa sta facendo laggiù..."

# game/scripts/story_02/bathroom.rpy:170 #-#-# translate crowdin ev_kira_shower_ladder_01_3ba6b805:
msgid "[_tMax_s_03_] Тётя у меня и так всегда сногсшибательна, а если ещё и сисечки начинает оголять, то у меня в шортах вообще огонь что творится! Но я всё равно буду глазеть без отрыва, пока она не пойдёт в душ..."
msgstr "[_tMax_s_03_] Mia zia è già sempre mozzafiato di suo, ma se inizia anche a scoprire le tette, nei miei pantaloncini scoppia letteralmente un incendio! Ma continuerò comunque a guardarla senza staccarle gli occhi di dosso, finché non andrà a farsi la doccia..."

# game/scripts/story_02/bathroom.rpy:176 #-#-# translate crowdin ev_kira_shower_ladder_01_01609df5:
msgid "[_tMax_s_04_] Ммм... Это самая настоящая секс-бомба, а не тётя! Жаль, что я не смогу любоваться всей этой красотой со стремянки и дальше, ведь она вот-вот пойдёт принимать душ. [nointeract]"
msgstr "[_tMax_s_04_] Mmm... È una vera e propria bomba sexy, altro che zia! Peccato che non potrò continuare ad ammirare tutta questa bellezza dalla scala, visto che sta per andare a farsi la doccia. [nointeract]"

# game/scripts/story_02/bathroom.rpy:190 #-#-# translate crowdin ev_kira_shower_ladder_02_699b49c4:
msgid "[_tMax_s_13_] В это время она уже во всю принимает душ и со стремянки я ничего интересного не увижу. Лучше подсматривать в начале или в конце часа... [nointeract]"
msgstr "[_tMax_s_13_] A quell'ora sta già facendo la doccia e non riesco a vedere nulla d'interessante dalla scaletta. È meglio sbirciare all'inizio o alla fine dell'ora... [nointeract]"

# game/scripts/story_02/bathroom.rpy:205 #-#-# translate crowdin ev_kira_shower_ladder_03_1d136386:
msgid "[_tMax_s_01_] Посмотрим, что она там делает..."
msgstr "[_tMax_s_01_] Vediamo cosa sta facendo laggiù..."

# game/scripts/story_02/bathroom.rpy:214 #-#-# translate crowdin ev_kira_shower_ladder_03_b668af2f:
msgid "[_tMax_s_04_] Похоже, тётя уже скоро покинет ванную комнату, но задержаться взглядом тут ещё определённо есть на что... [nointeract]"
msgstr "[_tMax_s_04_] Sembra che la zia stia già per uscire dal bagno, ma c'è ancora decisamente qualcosa su cui soffermarsi con lo sguardo... [nointeract]"

# §translate crowdin strings: #|#|# # game/scripts/story_02/bathroom.rpy:108
msgid "Извини, тётя Кира, в следующий раз обязательно отвернусь."
msgstr "Scusa, zia Kira, la prossima volta mi volterò di sicuro."

