msgstr "PREMIO"

# game/scripts/engine/04_images_0.rpy:901
msgid "Возможность свободного занятия физкультурой, пока мама занимается йогой"
msgstr "Poter fare attività fisica in libertà mentre la mamma fa yoga"

# game/scripts/engine/04_images_0.rpy:901
