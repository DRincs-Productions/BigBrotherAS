# game/scripts/story_01/bikini.rpy:436 #-#-# translate crowdin ev_145_bikini3_b6358413_1:
msgid "[_tMax_s_07_] Ага, заслужил и ещё как! Ох, сестрёнка, как же приятно с тобой целоваться..."
msgstr "[_tMax_s_07_] Sì, me lo sono meritato e come! Oh, sorellina, quanto è bello baciarti..."

# game/scripts/story_01/bikini.rpy:440 #-#-# translate crowdin ev_145_bikini3_a3107583:
msgid "[_Lisa_s_11_] Ого, Макс! Это что вообще такое сейчас было?!"
msgstr "[_Lisa_s_11_] Accidenti, Max! Ma cos'è stato questo?!"

# game/scripts/story_01/bikini.rpy:441 #-#-# translate crowdin ev_145_bikini3_1f5a1c0d:
msgid "[_Max_s_03_] Да так, показал тебе, как нужно чмокать."
msgstr "[_Max_s_03_] Niente di che... Ti ho solo mostrato come si fa a dare un bacio come si deve."

# game/scripts/story_01/bikini.rpy:442 #-#-# translate crowdin ev_145_bikini3_3ad32791:
msgid "[_Lisa_s_02_] Ничего себе, чмокнул так чмокнул! А нам так разве можно?"
msgstr "[_Lisa_s_02_] Caspita, che bacio! Ma ci è permesso fare così?"

# game/scripts/story_01/bikini.rpy:443 #-#-# translate crowdin ev_145_bikini3_187f40e0:
msgid "[_Max_s_11_] Если хочется, то почему бы и нет? Всё-таки мечту твою исполнили..."
msgstr "[_Max_s_11_] Se ne hai voglia, allora perché no? Dopotutto, abbiamo realizzato il tuo sogno..."

# game/scripts/story_01/bikini.rpy:444 #-#-# translate crowdin ev_145_bikini3_27d3c4a2:
msgid "[_Lisa_s_10_] Хм... Кстати, об этом... Тебе денег-то хватит заплатить за этот купальник? Он ведь дорогой..."
msgstr "[_Lisa_s_10_] Hm... A proposito... Ma avrai abbastanza soldi per pagare questo costume? Guarda che è molto caro..."

# game/scripts/story_01/bikini.rpy:445 #-#-# translate crowdin ev_145_bikini3_823a2b19_2:
