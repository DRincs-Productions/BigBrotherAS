msgstr "[_Max_s_01_] Non preoccuparti, non ce ne andremo senza niente... [nointeract]"

# game/scripts/story_01/bikini.rpy:474 #-#-# translate crowdin ev_145_bikini3_aa487975:
msgid "[_Lisa_] {b}Лиза:{/b}\n"
"Ох, Макс, как же мне нравится этот красный купальник! Смотри скорее..."
msgstr "[_Lisa_] {b}Lisa:{/b}\n"
"Oh, Max, quanto mi piace questo costume rosso! Guarda, presto..."

# game/scripts/story_01/bikini.rpy:475 #-#-# translate crowdin ev_145_bikini3_3ca682d0_1:
msgid "[_Max_s_02_] С удовольствием!"
msgstr "[_Max_s_02_] Con piacere!"

# game/scripts/story_01/bikini.rpy:479 #-#-# translate crowdin ev_145_bikini3_03563352_1:
msgid "[_Lisa_s_03_] Скажи же, что он классный?!"
msgstr "[_Lisa_s_03_] Dico che è fantastico?!"

# game/scripts/story_01/bikini.rpy:480 #-#-# translate crowdin ev_145_bikini3_e2da0b44_1:
msgid "[_Max_s_05_] О да! Тебе определённо он очень идёт. Удобный? Нигде не жмёт?"
msgstr "[_Max_s_05_] Oh sì! Ti sta divinamente. È comodo? Non stringe da nessuna parte?"

# game/scripts/story_01/bikini.rpy:481 #-#-# translate crowdin ev_145_bikini3_cf3f1f14_1:
msgid "[_Lisa_s_01_] Со всем этим полный порядок."
msgstr "[_Lisa_s_01_] È tutto in perfetto ordine. Non cambierei nulla."

# game/scripts/story_01/bikini.rpy:482 #-#-# translate crowdin ev_145_bikini3_0bc7d588_1:
msgid "[_Max_s_11_] И сзади тоже?"
msgstr "[_Max_s_11_] E anche dietro?"

# game/scripts/story_01/bikini.rpy:486 #-#-# translate crowdin ev_145_bikini3_8d53adcb_1:
msgid "[_Lisa_s_02_] Сам посмотри, всё ли там хорошо..."
msgstr "[_Lisa_s_02_] Guarda tu stesso se è tutto a posto lì dietro..."

# game/scripts/story_01/bikini.rpy:487 #-#-# translate crowdin ev_145_bikini3_c304859e_1:
msgid "[_Max_s_06_] Ухх... Знаешь, этот купальник просто шикарно сидит на твоей симпатичной попке!"
msgstr "[_Max_s_06_] Sai, questo bikini sta d'incanto sul tuo bel sedere!"

# game/scripts/story_01/bikini.rpy:488 #-#-# translate crowdin ev_145_bikini3_254fcb5d_1:
msgid "[_Lisa_s_11_] Хи-хи... Значит, надо брать, Макс!"
msgstr "[_Lisa_s_11_] Hi-hi... Allora è deciso, Max si prende!"

# game/scripts/story_01/bikini.rpy:490 #-#-# translate crowdin ev_145_bikini3_625b2225:
msgid "[_Max_s_03_] Обязательно. Давай переодевайся, а я пока пойду оплачу... [nointeract]"
msgstr "[_Max_s_03_] Assolutamente. Dai, rivestiti, io intanto vado a pagare... [nointeract]"

# game/scripts/story_01/bikini.rpy:495 #-#-# translate crowdin ev_145_bikini3_fbf5202a:
msgid "[_tMax_s_11_] Готово! Осталось дождаться сестрёнку. А вот и она..."
msgstr "[_tMax_s_11_] Fatto! Non resta che aspettare la sorellina. Eccola che arriva..."

# game/scripts/story_01/bikini.rpy:499 #-#-# translate crowdin ev_145_bikini3_dfe073ac_1:
msgid "[_Lisa_s_05_] Я так рада, Макс! И хочу крепкие обнимашки! Иди ко мне..."
msgstr "[_Lisa_s_05_] Sono così felice, Max! E voglio un abbraccio fortissimo! Vieni qui da me..."

# game/scripts/story_01/bikini.rpy:500 #-#-# translate crowdin ev_145_bikini3_ce5592f8_1:
msgid "[_tMax_s_04_] Вот это да! Лиза практически накинулась на меня с объятиями... Это так классно, когда она прижимается ко мне своей грудью!"
msgstr "[_tMax_s_04_]  Wow! Lisa mi ha praticamente gettato le braccia al collo... È così bello quando preme i suoi seni contro di me!"

# game/scripts/story_01/bikini.rpy:504 #-#-# translate crowdin ev_145_bikini3_851d888d:
msgid "[_Lisa_s_10_] Слушай, Макс, а тебе денег-то хватило заплатить за этот купальник? Он ведь дорогой..."
msgstr "[_Lisa_s_10_] Senti, Max, ma ti sono bastati i soldi per quel costume? Guarda che era davvero caro..."

# game/scripts/story_01/bikini.rpy:505 #-#-# translate crowdin ev_145_bikini3_823a2b19_3:
msgid "[_Max_s_04_] Да, пустяки..."
msgstr "[_Max_s_04_] Sì, sciocchezze..."

# game/scripts/story_01/bikini.rpy:506 #-#-# translate crowdin ev_145_bikini3_2809f92a_3:
msgid "[_Lisa_s_11_] Фух... А то было бы очень обидно уходить, после всех этих примерок, с пустыми руками."
msgstr "[_Lisa_s_11_] Fiuu... Altrimenti sarebbe stato un vero peccato andarsene a mani vuote dopo tutte queste prove."

# game/scripts/story_01/bikini.rpy:507 #-#-# translate crowdin ev_145_bikini3_26414e3c_3:
msgid "[_Max_s_01_] Не переживай, не уйдём..."
msgstr "[_Max_s_01_] Non preoccuparti, non ce ne andremo a mani vuote..."

# game/scripts/story_01/bikini.rpy:514 #-#-# translate crowdin ev_145_return_home_ed897e17:
msgid "[_Lisa_s_05_] Я всегда очень люблю возвращаться домой, но сегодня это так по особенному приятно!"
msgstr "[_Lisa_s_05_] Amo sempre tornare a casa, ma oggi è un piacere così speciale!"

# game/scripts/story_01/bikini.rpy:515 #-#-# translate crowdin ev_145_return_home_87e98e9f:
msgid "[_Max_s_02_] Тут не поспоришь."
msgstr "[_Max_s_02_] Su questo non si discute."

# game/scripts/story_01/bikini.rpy:520 #-#-# translate crowdin ev_145_return_home_bfdd8878:
msgid "[_Lisa_s_02_] Спасибо тебе ещё раз большое, Макс! Мне уже не терпится поплавать и позагорать в новом купальнике! Здорово, что это случится уже сегодня..."
msgstr "[_Lisa_s_02_] Grazie ancora di cuore, Max! Non vedo l'ora di nuotare e prendere il sole con il nuovo costume! È fantastico che succederà già oggi..."

# game/scripts/story_01/bikini.rpy:522 #-#-# translate crowdin ev_145_return_home_88e41613:
msgid "[_Lisa_s_02_] Спасибо тебе ещё раз большое, Макс! Мне уже не терпится поплавать и позагорать в новом купальнике! Жалко, что это случится только завтра..."
msgstr "[_Lisa_s_02_] Grazie ancora di cuore, Max! Non vedo l'ora di nuotare e prendere il sole con il nuovo costume! Peccato che succederà solo domani..."

# game/scripts/story_01/bikini.rpy:523 #-#-# translate crowdin ev_145_return_home_46806431:
msgid "[_Max_s_01_] Наслаждайся, сестрёнка."
msgstr "[_Max_s_01_] Goditela, sorellina."

# game/scripts/story_01/bikini.rpy:527 #-#-# translate crowdin ev_145_return_home_ce2e2eea:
msgid "[_Lisa_s_04_] Дай-ка я ещё раз тебя обниму... Даже не верится до сих пор, что у меня теперь есть новый купальник!"
msgstr "[_Lisa_s_04_] Lascia che ti abbracci ancora una volta... Non riesco ancora a credere di avere un costume nuovo!"

# game/scripts/story_01/bikini.rpy:528 #-#-# translate crowdin ev_145_return_home_2e670efc:
msgid "[_Max_s_04_] А ты надевай его почаще и всё пройдёт."
msgstr "[_Max_s_04_] Mettilo più spesso e vedrai che ti passerà tutto."

# game/scripts/story_01/bikini.rpy:529 #-#-# translate crowdin ev_145_return_home_c6d01307:
msgid "[_Lisa_s_11_] Макс, ну вот почему тебе так неймётся облапать мой зад, а?"
msgstr "[_Lisa_s_11_] Max, ma perché hai questa fissa di palparmi il sedere, eh?"

# game/scripts/story_01/bikini.rpy:530 #-#-# translate crowdin ev_145_return_home_7a55b1fb:
msgid "[_Max_s_01_] Даже не знаю, твоя попка прямо как-то сама под руку попала..."
msgstr "[_Max_s_01_] Non so nemmeno come, il tuo sedere è finito proprio sotto la mia mano..."

# game/scripts/story_01/bikini.rpy:534 #-#-# translate crowdin ev_145_return_home_08b752c9:
msgid "[_Lisa_s_02_] Ну да, ещё скажи, что она из неоткуда возникла и сразу в руке оказалась!"
msgstr "[_Lisa_s_02_] Sì, certo, e poi dimmi che è apparso dal nulla ed è finito dritto nella tua mano!"

# game/scripts/story_01/bikini.rpy:535 #-#-# translate crowdin ev_145_return_home_ec14d216:
msgid "[_Max_s_04_] Именно так и было! А мне оставалось её только потискать..."
msgstr "[_Max_s_04_] Proprio così! E a me restava solo di coccolarlo..."

# game/scripts/story_01/bikini.rpy:536 #-#-# translate crowdin ev_145_return_home_08ff3d23:
msgid "[_Lisa_s_01_] Надеюсь, ты вдоволь натискался? Сейчас ладно, так уж и быть, порадуйся, но в дальнейшем руки так нагло не распускай..."
msgstr "[_Lisa_s_01_] Spero che tu ti sia divertito abbastanza a palparmi. Per ora va bene, dai, goditela pure, ma in futuro non essere così sfacciato con le mani..."

# game/scripts/story_01/bikini.rpy:537 #-#-# translate crowdin ev_145_return_home_22527345:
msgid "[_Max_s_03_] Конечно..."
msgstr "[_Max_s_03_] Certo..."

