msgstr "Controllare i dati dal laptop di Alice"

# game/scripts/screens/laptop.rpy:21
msgid "АЛИСА НА «MYCAMS»"
msgstr "ALICE SU \"MYCAMS\""

# game/scripts/screens/laptop.rpy:50
msgid "Назад"
msgstr "Indietro"

# game/scripts/screens/laptop.rpy:54
msgid "Выключить"
msgstr "Spegnere"

# game/scripts/screens/laptop.rpy:68
