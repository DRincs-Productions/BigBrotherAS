# TODO: Translation updated at 2026-02-19 00:46 #|#|# # game/scripts/story_01/dinners.rpy:36 #-#-# translate crowdin ev_dinner_r1_24ac51ec:
msgid "[_Ann_s_01_] Всем приятного аппетита! Алиса столько всего наготовила сегодня, умничка. Давайте ужинать..."
msgstr ""

# game/scripts/story_01/dinners.rpy:39 #-#-# translate crowdin ev_dinner_r1_0be98adf:
msgid "[_Alice_s_01_] Ага, я такая! Приятного аппетита..."
msgstr ""

# game/scripts/story_01/dinners.rpy:41 #-#-# translate crowdin ev_dinner_r1_011f98c8:
msgid "[_Lisa_s_01_] Спасибо, Алиса! Приятного аппетита..."
msgstr ""

# game/scripts/story_01/dinners.rpy:46 #-#-# translate crowdin ev_dinner_r1_1c8a4074:
msgid "[_tMax_s_11_] Ммм... У Алисы получается готовить всё вкуснее и вкуснее! Денёк получился довольно обычным, поэтому и разговоров каких-то интересных не было. Всё хорошо..."
msgstr ""

# game/scripts/story_01/dinners.rpy:48 #-#-# translate crowdin ev_dinner_r1_0ab12a9d:
msgid "[_Ann_s_01_] Всем приятного аппетита! Много всего я сегодня наготовила, всем должно понравиться. Давайте ужинать..."
msgstr ""

# game/scripts/story_01/dinners.rpy:51 #-#-# translate crowdin ev_dinner_r1_3cbf4df6:
msgid "[_Alice_s_01_] Конечно, мам! Приятного аппетита..."
msgstr ""

# game/scripts/story_01/dinners.rpy:53 #-#-# translate crowdin ev_dinner_r1_3cc30d0a:
msgid "[_Lisa_s_01_] Спасибо, мам! Приятного аппетита..."
msgstr ""

# game/scripts/story_01/dinners.rpy:58 #-#-# translate crowdin ev_dinner_r1_ed34edee:
msgid "[_tMax_s_11_] Ммм... Вкуснее, чем готовит мама, больше никто не готовит! Денёк получился довольно обычным, поэтому и разговоров каких-то интересных не было. Всё хорошо..."
msgstr ""

# game/scripts/story_01/dinners.rpy:68 #-#-# translate crowdin dinner_inserts_f8dd8203:
msgid "[_Ann_s_02_] Макс, как твоя сегодняшняя поездка к Мие?"
msgstr ""

# game/scripts/story_01/dinners.rpy:69 #-#-# translate crowdin dinner_inserts_cc44457c:
msgid "[_Max_s_11_] Порядок, мам. Учу её плавать, но там тяжёлый случай. Даже приходится ещё и спасателем быть."
msgstr ""

# game/scripts/story_01/dinners.rpy:70 #-#-# translate crowdin dinner_inserts_056a7f8d:
msgid "[_Ann_s_11_] Ой, ужасы какие! Ты уж там аккуратнее с нашим адвокатом, она у нас хорошенькая."
msgstr ""

# game/scripts/story_01/dinners.rpy:71 #-#-# translate crowdin dinner_inserts_527cd8a2:
msgid "[_Max_s_01_] Конечно, не переживай."
msgstr ""

# game/scripts/story_01/dinners.rpy:75 #-#-# translate crowdin dinner_inserts_3a4740a6:
msgid "[_Alice_s_04_] Хм... Макса обычно из дома просто так не вытащишь. Что же там такого интересного в этих уроках плавания, не расскажешь?"
msgstr ""

# game/scripts/story_01/dinners.rpy:76 #-#-# translate crowdin dinner_inserts_48bad413:
msgid "[_Max_s_04_] А вот кое-что есть!"
msgstr ""

# game/scripts/story_01/dinners.rpy:82 #-#-# translate crowdin dinner_inserts_fa8864ae:
msgid "[_Ann_s_02_] Как там у Мии успехи с плаванием?"
msgstr ""

# game/scripts/story_01/dinners.rpy:83 #-#-# translate crowdin dinner_inserts_2721c973:
msgid "[_Max_s_03_] Пока только ещё учимся держаться на воде. Понемногу, но у неё получается..."
msgstr ""

# game/scripts/story_01/dinners.rpy:84 #-#-# translate crowdin dinner_inserts_15152164:
msgid "[_Ann_s_10_] Вот и славно. Только, сынок, постарайся не слишком сильно донимать её своими похабными шуточками."
msgstr ""

# game/scripts/story_01/dinners.rpy:85 #-#-# translate crowdin dinner_inserts_373a9368:
msgid "[_Max_s_11_] Я? Да я никогда..."
msgstr ""

# game/scripts/story_01/dinners.rpy:89 #-#-# translate crowdin dinner_inserts_3a4740a6_1:
msgid "[_Alice_s_04_] Хм... Макса обычно из дома просто так не вытащишь. Что же там такого интересного в этих уроках плавания, не расскажешь?"
msgstr ""

# game/scripts/story_01/dinners.rpy:90 #-#-# translate crowdin dinner_inserts_48bad413_1:
msgid "[_Max_s_04_] А вот кое-что есть!"
msgstr ""

# game/scripts/story_01/dinners.rpy:95 #-#-# translate crowdin dinner_inserts_79f27b6f:
msgid "[_Ann_s_02_] Рассказывай, Макс, как сегодня съездил к Мие?"
msgstr ""

# game/scripts/story_01/dinners.rpy:96 #-#-# translate crowdin dinner_inserts_16dd3f72:
msgid "[_Max_s_02_] Лучше, чем можно было представить! Она уже довольно уверенно держится на воде, так что мы начали отрабатывать все необходимые движения, чтобы плыть."
msgstr ""

# game/scripts/story_01/dinners.rpy:97 #-#-# translate crowdin dinner_inserts_81278ce5:
msgid "[_Ann_s_04_] Молодцы! Продолжайте в том же духе..."
msgstr ""

# game/scripts/story_01/dinners.rpy:98 #-#-# translate crowdin dinner_inserts_05f74506:
msgid "[_Max_s_12_] Пока не получится в том же духе. Ей нужно уехать на какое-то время, адвокатские дела и всё такое, но обещала продолжить уроки, как только вернётся."
msgstr ""

# game/scripts/story_01/dinners.rpy:99 #-#-# translate crowdin dinner_inserts_99457d8e:
msgid "[_Ann_s_03_] Прямо обещала? Ну, тогда можно не сомневаться..."
msgstr ""

# game/scripts/story_01/dinners.rpy:100 #-#-# translate crowdin dinner_inserts_9cd99e4e:
msgid "[_Max_s_13_] Пожалуй."
msgstr ""

# game/scripts/story_01/dinners.rpy:106 #-#-# translate crowdin dinner_inserts_1c9ce039:
msgid "[_Ann_s_10_] Девочки, а что это вы сегодня такие непомерно довольные? Признавайтесь..."
msgstr ""

# game/scripts/story_01/dinners.rpy:107 #-#-# translate crowdin dinner_inserts_525f6771:
msgid "[_Lisa_s_03_] Мне Макс подарил купальник! Именно тот, который я просила у тебя, мам! Представляешь?!"
msgstr ""

# game/scripts/story_01/dinners.rpy:108 #-#-# translate crowdin dinner_inserts_36ff2ca3:
msgid "[_Alice_s_04_] А мне он купил то чёрное платье, которое я столько времени просила у тебя! Так что не удивляйтесь, если пятничными вечерами меня не будет дома..."
msgstr ""

# game/scripts/story_01/dinners.rpy:109 #-#-# translate crowdin dinner_inserts_2bb5b36c:
msgid "[_Ann_s_11_] Ничего себе! Это, конечно, похвально... Но, сынок, это же всё дорого! Ты где взял деньги?"
msgstr ""

# game/scripts/story_01/dinners.rpy:110 #-#-# translate crowdin dinner_inserts_35da9d91:
msgid "[_Max_s_11_] Накопилось, вот и решил потратиться, чтобы твоя премия вся не разлетелась."
msgstr ""

# game/scripts/story_01/dinners.rpy:111 #-#-# translate crowdin dinner_inserts_7bdcc89b:
msgid "[_Ann_s_01_] Ладно, поверю на слово. Молодец, что помог нам с этим."
msgstr ""

# game/scripts/story_01/dinners.rpy:112 #-#-# translate crowdin dinner_inserts_4fb21c61:
msgid "[_Max_s_01_] Всегда пожалуйста."
msgstr ""

# game/scripts/story_01/dinners.rpy:117 #-#-# translate crowdin dinner_inserts_854818dc:
msgid "[_Ann_s_10_] Дети, а что это у нас сегодня Лиза такая довольная?"
msgstr ""

# game/scripts/story_01/dinners.rpy:118 #-#-# translate crowdin dinner_inserts_525f6771_1:
msgid "[_Lisa_s_03_] Мне Макс подарил купальник! Именно тот, который я просила у тебя, мам! Представляешь?!"
msgstr ""

# game/scripts/story_01/dinners.rpy:121 #-#-# translate crowdin dinner_inserts_d86f2bd4:
msgid "[_Alice_s_04_] Ого, вот это ты Макс последнее время разошёлся!"
msgstr ""

# game/scripts/story_01/dinners.rpy:123 #-#-# translate crowdin dinner_inserts_adcf01ad:
msgid "[_Alice_s_11_] Что сделал?!"
msgstr ""

# game/scripts/story_01/dinners.rpy:125 #-#-# translate crowdin dinner_inserts_6a5c4268:
msgid "[_Ann_s_11_] Ничего себе! Это, конечно, похвально... Надеюсь, сынок, ты не разорился на этом?"
msgstr ""

# game/scripts/story_01/dinners.rpy:126 #-#-# translate crowdin dinner_inserts_f83df4da:
msgid "[_Max_s_11_] Нет, всё в порядке, не волнуйся."
msgstr ""

# game/scripts/story_01/dinners.rpy:127 #-#-# translate crowdin dinner_inserts_8d62bb00:
msgid "[_Ann_s_01_] Ладно, поверю на слово."
msgstr ""

# game/scripts/story_01/dinners.rpy:128 #-#-# translate crowdin dinner_inserts_d1ed9e19:
msgid "[_Max_s_01_] Так и есть."
msgstr ""

# game/scripts/story_01/dinners.rpy:133 #-#-# translate crowdin dinner_inserts_191ed456:
msgid "[_Alice_s_04_] Кстати, мам... Должна тебя предупредить, мне Макс купил то чёрное платье, которое я столько времени просила у тебя! Так что не удивляйтесь, если пятничными вечерами меня не будет дома..."
msgstr ""

# game/scripts/story_01/dinners.rpy:136 #-#-# translate crowdin dinner_inserts_341d081a:
msgid "[_Lisa_s_02_] Ничего себе у нас Макс последнее время разошёлся!"
msgstr ""

# game/scripts/story_01/dinners.rpy:138 #-#-# translate crowdin dinner_inserts_ddff9fe3:
msgid "[_Lisa_s_10_] Правда?! Надо же..."
msgstr ""

# game/scripts/story_01/dinners.rpy:140 #-#-# translate crowdin dinner_inserts_74b39d50:
msgid "[_Ann_s_10_] Так, подождите... Сынок, оно же дорогое! Ты где взял деньги?"
msgstr ""

# game/scripts/story_01/dinners.rpy:141 #-#-# translate crowdin dinner_inserts_35da9d91_1:
msgid "[_Max_s_11_] Накопилось, вот и решил потратиться, чтобы твоя премия вся не разлетелась."
msgstr ""

# game/scripts/story_01/dinners.rpy:142 #-#-# translate crowdin dinner_inserts_7bdcc89b_1:
msgid "[_Ann_s_01_] Ладно, поверю на слово. Молодец, что помог нам с этим."
msgstr ""

# game/scripts/story_01/dinners.rpy:143 #-#-# translate crowdin dinner_inserts_1f93b9e6:
msgid "[_Max_s_01_] Без проблем."
msgstr ""

# game/scripts/story_01/dinners.rpy:155 #-#-# translate crowdin ev_009_e3b48c17:
msgid "[_Ann_s_02_] Рада, что все смогли сегодня собраться. Всем приятного аппетита! Ну, у кого как день прошёл?"
msgstr ""

# game/scripts/story_01/dinners.rpy:156 #-#-# translate crowdin ev_009_001f19e2:
msgid "[_Alice_s_02_] Мам, да у нас всё как обычно. Это ты рассказывай, как первый рабочий день?"
msgstr ""

# game/scripts/story_01/dinners.rpy:157 #-#-# translate crowdin ev_009_1d802de4:
msgid "[_Ann_s_01_] Вы знаете, довольно неплохо. Такой офис! Такие все важные. Но я смогу там работать и даже планирую подняться по карьерной лестнице..."
msgstr ""

# game/scripts/story_01/dinners.rpy:158 #-#-# translate crowdin ev_009_6dc50b10:
msgid "[_Max_s_13_] Напомни, а кем ты работаешь?"
msgstr ""

# game/scripts/story_01/dinners.rpy:159 #-#-# translate crowdin ev_009_e66ba414:
msgid "[_Ann_s_11_] Что, Макс, с памятью проблемы? Может, попросить врача выписать тебе витамины? Я работаю в отделе развития и занимаюсь маркетингом."
msgstr ""

# game/scripts/story_01/dinners.rpy:160 #-#-# translate crowdin ev_009_42f759d1:
msgid "[_Max_s_01_] Точно. Ну, поздравляю!"
msgstr ""

# game/scripts/story_01/dinners.rpy:161 #-#-# translate crowdin ev_009_74079050:
msgid "[_Ann_s_03_] Спасибо, Макс. Вы всё вопросы задаёте. Поели бы хоть немного. Кстати, Алиса, ты молодец, что приготовила ужин. Сама я бы ещё долго возилась."
msgstr ""

# game/scripts/story_01/dinners.rpy:162 #-#-# translate crowdin ev_009_59c4cc1b:
msgid "[_Alice_s_01_] Не за что. Ты же сама меня научила всему, вот и пожинай плоды!"
msgstr ""

# game/scripts/story_01/dinners.rpy:163 #-#-# translate crowdin ev_009_302f53c5:
msgid "[_Max_s_11_] А где находится твой офис?"
msgstr ""

# game/scripts/story_01/dinners.rpy:164 #-#-# translate crowdin ev_009_9b119a88:
msgid "[_Ann_s_12_] Вот с этим беда. На общественном транспорте добираться долго. Но думаю, что эта проблема решится..."
msgstr ""

# game/scripts/story_01/dinners.rpy:165 #-#-# translate crowdin ev_009_ee138e14:
msgid "[_Lisa_s_11_] А с начальником повезло?"
msgstr ""

# game/scripts/story_01/dinners.rpy:166 #-#-# translate crowdin ev_009_c1d533ec:
msgid "[_Ann_s_10_] Ну мой непосредственный начальник - лысый толстый мужик, которого все ненавидят. Думаю, его скоро сменят. А вот босс моего начальника..."
msgstr ""

# game/scripts/story_01/dinners.rpy:167 #-#-# translate crowdin ev_009_955b8ecb:
msgid "[_Max_s_03_] Ещё толще и лысее?"
msgstr ""

# game/scripts/story_01/dinners.rpy:168 #-#-# translate crowdin ev_009_0365007f:
msgid "[_Ann_s_04_] Вот он - мужчина что надо! Сразу меня заметил, помог разобраться в делах. И даже до дома подвёз! Может быть, он мне даже личного водителя выделит!"
msgstr ""

# game/scripts/story_01/dinners.rpy:169 #-#-# translate crowdin ev_009_c5f3e8ef:
msgid "[_Max_s_12_] Ого! Да он в тебя влюбился?"
msgstr ""

# game/scripts/story_01/dinners.rpy:170 #-#-# translate crowdin ev_009_645b8e37:
msgid "[_Ann_s_11_] Почему сразу влюбился? Может быть, он джентльмен, который помогает новенькой на новом месте работы..."
msgstr ""

# game/scripts/story_01/dinners.rpy:171 #-#-# translate crowdin ev_009_e1d87a63:
msgid "[_Max_s_13_] И как его зовут?"
msgstr ""

# game/scripts/story_01/dinners.rpy:172 #-#-# translate crowdin ev_009_409ac362:
msgid "[_Ann_s_01_] Его зовут Эрик. Фамилия вам ничего не даст, так что, это не важно. Может быть, я вас однажды и познакомлю..."
msgstr ""

# game/scripts/story_01/dinners.rpy:173 #-#-# translate crowdin ev_009_f2b30c18:
msgid "[_Max_s_14_] Значит, он тебе нравится..."
msgstr ""

# game/scripts/story_01/dinners.rpy:174 #-#-# translate crowdin ev_009_71e76301:
msgid "[_Ann_s_12_] Я уже сказала, что он симпатичный состоявшийся мужчина и это нормально... Или не сказала? Не важно. Хватит меня допрашивать, всё остывает!"
msgstr ""

# game/scripts/story_01/dinners.rpy:175 #-#-# translate crowdin ev_009_237a7b12:
msgid "[_Lisa_s_09_] Ну мам, расскажи больше..."
msgstr ""

# game/scripts/story_01/dinners.rpy:176 #-#-# translate crowdin ev_009_a440551c:
msgid "[_Ann_s_02_] Сегодня не у меня одной первый день. Лиза тоже пошла в новую школу. Рассказывай, как у тебя всё прошло?"
msgstr ""

# game/scripts/story_01/dinners.rpy:177 #-#-# translate crowdin ev_009_bee8bd6e:
msgid "[_Lisa_s_01_] Ну, школа находится тут совсем рядом, почти за углом. Уроки короткие, занятий мало. Но преподают интересно, гораздо лучше, чем в старой школе. Думаю, здесь даже Максу понравилось бы учиться!"
msgstr ""

# game/scripts/story_01/dinners.rpy:178 #-#-# translate crowdin ev_009_57b9e2c8:
msgid "[_Ann_s_03_] Ну а ученики какие? Повезло с классом? Уже завела себе друзей и подруг?"
msgstr ""

# game/scripts/story_01/dinners.rpy:179 #-#-# translate crowdin ev_009_c60e19ee:
msgid "[_Lisa_s_02_] Да, познакомилась... с одной подружкой. Класс супер... Всё хорошо, мам!"
msgstr ""

# game/scripts/story_01/dinners.rpy:180 #-#-# translate crowdin ev_009_3f8e29f7:
msgid "[_Max_s_01_] Что за подружка? Как зовут?"
msgstr ""

# game/scripts/story_01/dinners.rpy:181 #-#-# translate crowdin ev_009_ce277c38:
msgid "[_Lisa_s_11_] Ой, да обычная подружка..."
msgstr ""

# game/scripts/story_01/dinners.rpy:182 #-#-# translate crowdin ev_009_3e93b9d6:
msgid "[_Alice_s_04_] Кажется, у кого-то секреты..."
msgstr ""

# game/scripts/story_01/dinners.rpy:183 #-#-# translate crowdin ev_009_f218abab:
msgid "[_Lisa_s_09_] Ну что вы, в самом деле. Ну да, с парнем познакомилась. Зовут Алекс. Учимся вместе, сидим рядом!"
msgstr ""

# game/scripts/story_01/dinners.rpy:184 #-#-# translate crowdin ev_009_4186981a:
msgid "[_Max_s_11_] Так бы сразу и сказала!"
msgstr ""

# game/scripts/story_01/dinners.rpy:185 #-#-# translate crowdin ev_009_c8b74720:
msgid "[_Lisa_s_12_] А я так и сказала! Всё. Больше ничего не спрашивайте!"
msgstr ""

# game/scripts/story_01/dinners.rpy:186 #-#-# translate crowdin ev_009_fa72dad8:
msgid "[_Ann_s_11_] Извини, Лиза, я же не знала. Я вот тоже познакомилась с Эриком в первый же день. Не мне тебя судить!"
msgstr ""

# game/scripts/story_01/dinners.rpy:187 #-#-# translate crowdin ev_009_819371d9:
msgid "[_Lisa_s_11_] Да всё в порядке, мам. Просто мы только познакомились, поболтали и улыбнулись друг другу. А всё выглядит так, будто у меня уже есть парень..."
msgstr ""

# game/scripts/story_01/dinners.rpy:188 #-#-# translate crowdin ev_009_6c068817:
msgid "[_Ann_s_01_] Тоже верно... Так, ладно. Спасибо всем за ужин. Лиза, сейчас как раз твоя очередь мыть посуду?"
msgstr ""

# game/scripts/story_01/dinners.rpy:189 #-#-# translate crowdin ev_009_58c3ff02:
msgid "[_Lisa_s_02_] Да, мам. Но если мне кто-то поможет... Например, Макс, то я не откажусь..."
msgstr ""

# game/scripts/story_01/dinners.rpy:190 #-#-# translate crowdin ev_009_7267ed68:
msgid "[_Max_s_12_] Может быть..."
msgstr ""

# game/scripts/story_01/dinners.rpy:191 #-#-# translate crowdin ev_009_091abc12:
msgid "[_Ann_s_02_] Ладно, разбирайтесь сами. А я собираюсь принять ванну. Так что, меня не беспокоить!"
msgstr ""

# game/scripts/story_01/dinners.rpy:192 #-#-# translate crowdin ev_009_f930d279:
msgid "[_Max_s_01_] Хорошо, мам!"
msgstr ""

# game/scripts/story_01/dinners.rpy:207 #-#-# translate crowdin ev_031_94439a9d:
msgid "[_Ann_s_01_] Всем приятного аппетита. У кого какие новости? Рассказывайте..."
msgstr ""

# game/scripts/story_01/dinners.rpy:208 #-#-# translate crowdin ev_031_eeef1f40:
msgid "[_Alice_s_12_] Я пытаюсь своим блогом заниматься. Вечерами. Иногда. Когда возможность подворачивается..."
msgstr ""

# game/scripts/story_01/dinners.rpy:209 #-#-# translate crowdin ev_031_f85b2904:
msgid "[_Lisa_s_09_] Возможность? А что такое?"
msgstr ""

# game/scripts/story_01/dinners.rpy:210 #-#-# translate crowdin ev_031_7f00a3d9:
msgid "[_Alice_s_11_] Лиза, я же тебе говорила, что в тех вещах, что пропали, были все мои кремы, лаки, про которые я и вела свой бьюти-блог..."
msgstr ""

# game/scripts/story_01/dinners.rpy:211 #-#-# translate crowdin ev_031_4a7a548c:
msgid "[_Lisa_s_10_] Ой, точно. Извини, я совсем забыла про это. Да, сочувствую..."
msgstr ""

# game/scripts/story_01/dinners.rpy:212 #-#-# translate crowdin ev_031_4baef4f7:
msgid "[_Ann_s_10_] Бьюти-блог... Эх, Алиса, лучше бы делом занялась! Тебе поступать пора, а ты воздух пинаешь. Сидела бы и готовилась!"
msgstr ""

# game/scripts/story_01/dinners.rpy:213 #-#-# translate crowdin ev_031_98523a54:
msgid "[_Max_s_13_] А на какие шиши она будет поступать?"
msgstr ""

# game/scripts/story_01/dinners.rpy:214 #-#-# translate crowdin ev_031_cd200cf4:
msgid "[_Ann_s_12_] Ну, я не знаю. Денег лишних у нас нет, но одарённые дети точно могут учиться бесплатно. Им ещё и стипендию доплачивают..."
msgstr ""

# game/scripts/story_01/dinners.rpy:215 #-#-# translate crowdin ev_031_a286395a:
msgid "[_Max_s_11_] Это круто, но при чём тут Алиса?"
msgstr ""

# game/scripts/story_01/dinners.rpy:216 #-#-# translate crowdin ev_031_94b27ad3:
msgid "[_Alice_s_01_] Очень смешно, Макс. А если серьёзно, то на блогах и стриминге можно заработать больше, чем на работе после нескольких лет учёбы!"
msgstr ""

# game/scripts/story_01/dinners.rpy:217 #-#-# translate crowdin ev_031_d791faa8:
msgid "[_Max_s_13_] И какой у тебя план?"
msgstr ""

# game/scripts/story_01/dinners.rpy:218 #-#-# translate crowdin ev_031_5768addf:
msgid "[_Alice_s_02_] Мне нужно по новой собрать всё необходимое для полноценного ведения блога. Вот такой план. Пока что я понемногу зарабатываю на это проводя стримы по видеоиграм."
msgstr ""

# game/scripts/story_01/dinners.rpy:219 #-#-# translate crowdin ev_031_debe6434:
msgid "[_Max_s_01_] Всё с тобой ясно... Как у меня появятся лишние деньги, сразу тебе помогу."
msgstr ""

# game/scripts/story_01/dinners.rpy:220 #-#-# translate crowdin ev_031_7462b0f4:
msgid "[_Alice_s_11_] Ну да, ну да... Я уже это слышала..."
msgstr ""

# game/scripts/story_01/dinners.rpy:221 #-#-# translate crowdin ev_031_1fbeb5b5:
msgid "[_Ann_s_11_] Ох, детишки... Не понимаю я ничего в этих ваших блогах и не уверена, что на это надо тратить своё время, но разберётесь. Я хотела спросить, ни к кому в комнату никакая живность не заползала?"
msgstr ""

# game/scripts/story_01/dinners.rpy:222 #-#-# translate crowdin ev_031_9e79907d:
msgid "[_Lisa_s_11_] Вроде нет, а что?"
msgstr ""

# game/scripts/story_01/dinners.rpy:223 #-#-# translate crowdin ev_031_660e3b44:
msgid "[_Ann_s_00_] Да я сегодня огромного паука видела... Даже не знала, что такие бывают..."
msgstr ""

# game/scripts/story_01/dinners.rpy:224 #-#-# translate crowdin ev_031_9e5e8cce:
msgid "[_Alice_s_14_] Что?! Здесь есть пауки?! Мама... я поехала обратно..."
msgstr ""

# game/scripts/story_01/dinners.rpy:225 #-#-# translate crowdin ev_031_3536f78e:
msgid "[_Max_s_11_] Ты что, пауков боишься?"
msgstr ""

# game/scripts/story_01/dinners.rpy:226 #-#-# translate crowdin ev_031_e56d6d16:
msgid "[_Lisa_s_03_] Макс, ты что, забыл? В прошлом году маленький паучок летом на Алису заполз, так она орала два часа! Бегала и кричала..."
msgstr ""

# game/scripts/story_01/dinners.rpy:227 #-#-# translate crowdin ev_031_03024440:
msgid "[_Max_s_03_] Что-то такое было, вроде бы..."
msgstr ""

# game/scripts/story_01/dinners.rpy:228 #-#-# translate crowdin ev_031_3bbee6a3:
msgid "[_Alice_s_15_] Ага, маленький... Да он был с тебя размером! Ненавижу пауков. Кто их, вообще, выдумал. Хоть на северный полюс уезжай. Надеюсь, хоть там их нет..."
msgstr ""

# game/scripts/story_01/dinners.rpy:229 #-#-# translate crowdin ev_031_5e9465c7:
msgid "[_Max_s_04_] Нам тебя будет не хватать..."
msgstr ""

# game/scripts/story_01/dinners.rpy:230 #-#-# translate crowdin ev_031_d5873d26:
msgid "[_Alice_s_11_] А вот знаешь что, Макс, не дождёшься! Я не видела ещё ни одного паука и, может быть, это маме только показалось. Буду думать так. Так спокойнее..."
msgstr ""

# game/scripts/story_01/dinners.rpy:231 #-#-# translate crowdin ev_031_15bd2c0c:
msgid "[_Max_s_01_] Ну, думай... Но если тебе тоже начнёт что-то такое казаться, можешь сразу звать меня. Я разберусь!"
msgstr ""

# game/scripts/story_01/dinners.rpy:232 #-#-# translate crowdin ev_031_0b16191b:
msgid "[_Ann_s_02_] Так, ладно. Думайте что хотите, а вам всем спасибо за ужин. Я пойду немного поваляюсь в ванне..."
msgstr ""

# game/scripts/story_01/dinners.rpy:233 #-#-# translate crowdin ev_031_03f5e78a:
msgid "[_Max_s_02_] Ага, всем спасибо."
msgstr ""

# game/scripts/story_01/dinners.rpy:247 #-#-# translate crowdin ev_047_2c81542f:
msgid "[_Ann_s_10_] Прежде, чем мы начнём, скажи-ка мне, Лиза, ты справилась с контрольной работой, которая была сегодня в школе?"
msgstr ""

# game/scripts/story_01/dinners.rpy:248 #-#-# translate crowdin ev_047_2bd932db:
msgid "[_Lisa_s_09_] Ну... Так... Не очень..."
msgstr ""

# game/scripts/story_01/dinners.rpy:249 #-#-# translate crowdin ev_047_51012997:
msgid "[_Ann_s_15_] Не очень?! Лиза, я уже знаю, что ты получила двойку! Хочешь, чтобы и тебя выперли из школы, как нашего балбеса Макса?"
msgstr ""

# game/scripts/story_01/dinners.rpy:250 #-#-# translate crowdin ev_047_776de7bd:
msgid "[_Max_s_13_] Эй! Меня же не за знания выгнали! Я хорошо учился..."
msgstr ""

# game/scripts/story_01/dinners.rpy:251 #-#-# translate crowdin ev_047_23b4a283:
msgid "[_Lisa_s_12_] Ну мам... У нас в прошлой школе не было анатомии, а тут химико-биологический класс с углублённым изучением. Конечно, я не смогла сдать контрольную!"
msgstr ""

# game/scripts/story_01/dinners.rpy:252 #-#-# translate crowdin ev_047_45c4fc72:
msgid "[_Ann_s_14_] Что значит «конечно не смогла»?! А ну-ка иди сюда. Сейчас я тебя накажу, чтобы ты взялась за ум!"
msgstr ""

# game/scripts/story_01/dinners.rpy:257 #-#-# translate crowdin ev_047_4b0a16b6:
msgid "[_Lisa_s_10_] Ну мам... Я же не специально. Я обещаю, что всё выучу! [nointeract]"
msgstr ""

# game/scripts/story_01/dinners.rpy:260 #-#-# translate crowdin ev_047_46955750:
msgid "[_Ann_s_10_] Ох, Лиза! Скажи спасибо своему брату, что он за тебя заступился. Так уж и быть, дам тебе шанс..."
msgstr ""

# game/scripts/story_01/dinners.rpy:264 #-#-# translate crowdin ev_047_d6c8e110:
msgid "[_Lisa_s_13_] Спасибо, Макс!!! Как хорошо, что ты поможешь мне с уроками!"
msgstr ""

# game/scripts/story_01/dinners.rpy:265 #-#-# translate crowdin ev_047_c6457cf8:
msgid "[_Max_s_12_] Тебе может и хорошо..."
msgstr ""

# game/scripts/story_01/dinners.rpy:267 #-#-# translate crowdin ev_047_22951ecd:
msgid "[_Ann_s_00_] Так, хватит, потом разберётесь. Сейчас время ужина. Давайте садитесь, приятного аппетита!"
msgstr ""

# game/scripts/story_01/dinners.rpy:272 #-#-# translate crowdin ev_047_83dcb116:
msgid "[_Ann_s_10_] Быстро! На этот раз можешь шорты не снимать, но в следующий раз получишь по голой заднице у всех на глазах. Иди сюда!"
msgstr ""

# game/scripts/story_01/dinners.rpy:278 #-#-# translate crowdin ev_047_1561bed3:
msgid "[_Lisa_s_14_] Ой... Мам! Больно!"
msgstr ""

# game/scripts/story_01/dinners.rpy:282 #-#-# translate crowdin ev_047_525f5f36:
msgid "[_Ann_s_14_] Давай терпи. За двойки я всегда наказываю. В этот раз не сильно, чтобы ты понимала, что никакие отговорки или причины меня интересовать не будут. Получила двойку, получила по заднице у всех на глазах. Ясно?"
msgstr ""

# game/scripts/story_01/dinners.rpy:283 #-#-# translate crowdin ev_047_4fd6e65c:
msgid "[_Lisa_s_12_] Ой. Да. Ясно, мам. Я всё поняла!"
msgstr ""

# game/scripts/story_01/dinners.rpy:288 #-#-# translate crowdin ev_047_12cde1ef:
msgid "[_Ann_s_10_] Вот и хорошо, что поняла. А ты, Макс, помоги своей сестре с учёбой! Нам сейчас не до репетиторов, сам понимаешь."
msgstr ""

# game/scripts/story_01/dinners.rpy:289 #-#-# translate crowdin ev_047_9fd7fbff:
msgid "[_Max_s_16_] Погодите! Так я... это..."
msgstr ""

# game/scripts/story_01/dinners.rpy:290 #-#-# translate crowdin ev_047_3f330923:
msgid "[_Ann_s_14_] Макс, ты уверен, что хочешь поискать отговорки после того, что сейчас было?"
msgstr ""

# game/scripts/story_01/dinners.rpy:291 #-#-# translate crowdin ev_047_3fc24269:
msgid "[_Max_s_12_] Нет, мам. Я ей помогу..."
msgstr ""

# game/scripts/story_01/dinners.rpy:295 #-#-# translate crowdin ev_047_2b1dccc4:
msgid "[_Ann_s_00_] Вот и замечательно. Давайте скорее ужинать пока не остыло. Приятного аппетита!"
msgstr ""

# game/scripts/story_01/dinners.rpy:303 #-#-# translate crowdin ev_047_da58e422:
msgid "[_Max_s_00_] Приятного аппетита!"
msgstr ""

# game/scripts/story_01/dinners.rpy:304 #-#-# translate crowdin ev_047_da3262bc:
msgid "[_Ann_s_11_] Знаете, я всё хотела спросить, только меня смущают картины, которые висят в наших комнатах?"
msgstr ""

# game/scripts/story_01/dinners.rpy:305 #-#-# translate crowdin ev_047_9491db6a:
msgid "[_Max_s_04_] Ты про тех голых женщин в ваших спальнях?"
msgstr ""

# game/scripts/story_01/dinners.rpy:306 #-#-# translate crowdin ev_047_77ba3305:
msgid "[_Alice_s_02_] Да, Макс, про тех. А что, мам, тебе не нравится? Там же нет ничего такого. Думаю, что это даже искусство... Лично меня всё устраивает!"
msgstr ""

# game/scripts/story_01/dinners.rpy:307 #-#-# translate crowdin ev_047_54baecf5:
msgid "[_Ann_s_01_] Ну, если вы так говорите... Я сначала хотела их снять, чтобы не смущать никого. Ваш отец, видимо, холостяцкий дом строил и оформлял соответственно... Но если никого не смущает, то и меня всё устраивает."
msgstr ""

# game/scripts/story_01/dinners.rpy:308 #-#-# translate crowdin ev_047_030336ae:
msgid "[_Lisa_s_00_] Кстати, про него не было новостей?"
msgstr ""

# game/scripts/story_01/dinners.rpy:309 #-#-# translate crowdin ev_047_5bfc02ec:
msgid "[_Ann_s_10_] Нет, и слава богу. Конечно, я рада этому подарку, этому дому. Хотя, до сих пор не понимаю с чего он так расщедрился. Но даже так не компенсировать пропущенные годы вашего воспитания и семейной жизни..."
msgstr ""

# game/scripts/story_01/dinners.rpy:310 #-#-# translate crowdin ev_047_d396a478:
msgid "[_Max_s_13_] Интересно, где он сейчас..."
msgstr ""

# game/scripts/story_01/dinners.rpy:311 #-#-# translate crowdin ev_047_5c1096a2:
msgid "[_Ann_s_02_] Ох, да без разницы где. Между прочим, завтра у компании, в которой я работаю, состоится какое-то праздничное мероприятие. Так что вечером мне нужно будет отлучиться. Эрик даже пообещал за мной заехать..."
msgstr ""

# game/scripts/story_01/dinners.rpy:312 #-#-# translate crowdin ev_047_8560bd3a:
msgid "[_Alice_s_04_] Ого! Значит, мы наконец-то увидим, что там за мужчина подкатывает к нашей маме!"
msgstr ""

# game/scripts/story_01/dinners.rpy:313 #-#-# translate crowdin ev_047_3a25fcea:
msgid "[_Ann_s_03_] Ну, не буду забегать наперёд, но кажется его интерес ко мне довольно серьёзен. Его даже нисколько не смутило то, что у меня трое детей."
msgstr ""

# game/scripts/story_01/dinners.rpy:314 #-#-# translate crowdin ev_047_3ad83dba:
msgid "[_Max_s_01_] Мам, мне кажется, наличие трёх детей у такой шикарной женщины, как ты, должно только восхищать."
msgstr ""

# game/scripts/story_01/dinners.rpy:315 #-#-# translate crowdin ev_047_63002386:
msgid "[_Ann_s_04_] Ой, сынок, спасибо! Очень приятно такое слышать. Возможно, на этом мероприятии мне удастся узнать его получше. Потому что в офисе было несколько не до этого."
msgstr ""

# game/scripts/story_01/dinners.rpy:316 #-#-# translate crowdin ev_047_2e654575:
msgid "[_Lisa_s_11_] Тогда, мам, мы с нетерпением будем ждать от тебя подробностей!"
msgstr ""

# game/scripts/story_01/dinners.rpy:317 #-#-# translate crowdin ev_047_c5a4036e:
msgid "[_Ann_s_01_] Договорились. Думаю, ужин закончен. Всем спасибо. Лиза, как всегда, моет посуду, а я отдыхать..."
msgstr ""

# game/scripts/story_01/dinners.rpy:328 #-#-# translate crowdin ev_054_c258aaea:
msgid "[_Ann_s_00_] Хорошо, что все в сборе, даже Алиса на месте. Приятного аппетита, давайте ужинать."
msgstr ""

# game/scripts/story_01/dinners.rpy:329 #-#-# translate crowdin ev_054_9a8f7de0:
msgid "[_Max_s_03_] Так у неё выбора нет, она же на мели, а кушать хочется."
msgstr ""

# game/scripts/story_01/dinners.rpy:330 #-#-# translate crowdin ev_054_5028054d:
msgid "[_Alice_s_11_] Ох, Макс, однажды ты дошутишься..."
msgstr ""

# game/scripts/story_01/dinners.rpy:331 #-#-# translate crowdin ev_054_db1bd55e:
msgid "[_Max_s_05_] Ой! И что будет? Закатишь истерику и убежишь?!"
msgstr ""

# game/scripts/story_01/dinners.rpy:332 #-#-# translate crowdin ev_054_3f63c668:
msgid "[_Alice_s_16_] Ах ты гадёныш мелкий, сейчас я тебе..."
msgstr ""

# game/scripts/story_01/dinners.rpy:333 #-#-# translate crowdin ev_054_4af80e1d:
msgid "[_Ann_s_14_] Так, ну-ка быстро прекратили, не надо портить вечер."
msgstr ""

# game/scripts/story_01/dinners.rpy:334 #-#-# translate crowdin ev_054_212319d0:
msgid "[_Alice_s_15_] Ты его испортила, когда купила себе платье."
msgstr ""

# game/scripts/story_01/dinners.rpy:335 #-#-# translate crowdin ev_054_cec8a1a3:
msgid "[_Ann_s_10_] Алиса, мы живём на мои деньги, а значит если мне необходимо что-то купить, то я это куплю в самую первую очередь."
msgstr ""

# game/scripts/story_01/dinners.rpy:336 #-#-# translate crowdin ev_054_ec4fbcd4:
msgid "[_Alice_s_11_] Да что ты! Ну и вот какая у тебя в нём необходимость?"
msgstr ""

# game/scripts/story_01/dinners.rpy:337 #-#-# translate crowdin ev_054_44d62526:
msgid "[_Ann_s_14_] Я тебе уже говорила, мне важно произвести впечатление на работников компании. Это, между прочим, может помочь быстрее продвинуться по должности, потому что большинство руководителей - мужчины."
msgstr ""

# game/scripts/story_01/dinners.rpy:338 #-#-# translate crowdin ev_054_c0cbeaf3:
msgid "[_Max_s_01_] Безупречная логика, мам!"
msgstr ""

# game/scripts/story_01/dinners.rpy:339 #-#-# translate crowdin ev_054_7b953bc9:
msgid "[_Alice_s_04_] Тогда нужно было покупать платье поскромнее. А в том, что ты купила, тебя захотят трахнуть все и разом."
msgstr ""

# game/scripts/story_01/dinners.rpy:340 #-#-# translate crowdin ev_054_9320ff6a:
msgid "[_Ann_s_16_] Алиса!!! Ты сейчас, за такие слова, по заднице у меня схлопочешь!"
msgstr ""

# game/scripts/story_01/dinners.rpy:341 #-#-# translate crowdin ev_054_efbf2424:
msgid "[_Max_s_11_] Я бы на это посмотрел! И на платье, и на покрасневший зад Алисы..."
msgstr ""

# game/scripts/story_01/dinners.rpy:342 #-#-# translate crowdin ev_054_a785e71f:
msgid "[_Alice_s_11_] Я нисколько не сомневаюсь, что ты это платье купила не из расчёта на всех мужиков в компании, а на конкретного мужика... И мы все знаем какого именно."
msgstr ""

# game/scripts/story_01/dinners.rpy:343 #-#-# translate crowdin ev_054_4f8b645e:
msgid "[_Ann_s_10_] Может и так. Эрик настоящий мужчина и находится на руководящей должности. Поэтому, в первую очередь, я бы хотела произвести впечатление на него."
msgstr ""

# game/scripts/story_01/dinners.rpy:344 #-#-# translate crowdin ev_054_3f18c4cb:
msgid "[_Lisa_s_12_] Может хватит? Давайте просто спокойно поужинаем..."
msgstr ""

# game/scripts/story_01/dinners.rpy:345 #-#-# translate crowdin ev_054_6c3261c1:
msgid "[_Ann_s_15_] Хочешь обижаться, Алиса, пожалуйста. Но твоё платье точно подождёт, а вот мне важно выделиться в компании."
msgstr ""

# game/scripts/story_01/dinners.rpy:346 #-#-# translate crowdin ev_054_69aa0393:
msgid "[_Alice_s_15_] Да, да, да... Всё понятно..."
msgstr ""

# game/scripts/story_01/dinners.rpy:347 #-#-# translate crowdin ev_054_8e2f275e:
msgid "[_Ann_s_00_] Понятно ей... Спасибо всем за ужин. Я пойду собираться на корпоратив. Алиса остаётся за старшую, но если будет буянить, то обязательно скажите."
msgstr ""

# game/scripts/story_01/dinners.rpy:348 #-#-# translate crowdin ev_054_276a817f:
msgid "[_Lisa_s_11_] Не волнуйся, мам. Удачи тебе там."
msgstr ""

# game/scripts/story_01/dinners.rpy:359 #-#-# translate crowdin ev_067_7fa9c980:
msgid "[_Ann_s_01_] Молодцы, что все собрались. Всем приятного аппетита!"
msgstr ""

# game/scripts/story_01/dinners.rpy:360 #-#-# translate crowdin ev_067_5954c226:
msgid "[_Max_s_01_] Приятного..."
msgstr ""

# game/scripts/story_01/dinners.rpy:361 #-#-# translate crowdin ev_067_1ce89e05:
msgid "[_Ann_s_02_] Рассказывайте, девочки, как погуляли? Где были?"
msgstr ""

# game/scripts/story_01/dinners.rpy:362 #-#-# translate crowdin ev_067_ce421dab:
msgid "[_Alice_s_02_] Да так, по центру города погуляли, ели мороженое и в кинотеатр зашли."
msgstr ""

# game/scripts/story_01/dinners.rpy:363 #-#-# translate crowdin ev_067_f6cfa71d:
msgid "[_Lisa_s_13_] Ага, здесь такой огромный кинотеатр, мам! Мне там очень понравилось."
msgstr ""

# game/scripts/story_01/dinners.rpy:364 #-#-# translate crowdin ev_067_71fc7978:
msgid "[_Ann_s_00_] Умнички, что сходили. Но ты, Лиза, не забывай, что нужно пересдать контрольную. Требования в этой школе намного выше, чем в прошлой, но это не даёт тебе права учиться плохо. Ты меня поняла?"
msgstr ""

# game/scripts/story_01/dinners.rpy:365 #-#-# translate crowdin ev_067_a8a09d4e:
msgid "[_Lisa_s_02_] Да, я буду всю неделю готовиться к контрольной. Макс мне уже очень сильно помог в ней разобраться."
msgstr ""

# game/scripts/story_01/dinners.rpy:366 #-#-# translate crowdin ev_067_e636bca1:
msgid "[_Ann_s_10_] Молодцы! Но я бы, Макс, тебя попросила ещё проконтролировать выполнение того, что Лизе задают в школе. А то я чувствую, что она с этой пересдачей начнёт отставать по каким-нибудь предметам."
msgstr ""

# game/scripts/story_01/dinners.rpy:367 #-#-# translate crowdin ev_067_bb9b0766:
msgid "[_Max_s_13_] Проконтролировать?! Не знаю, не знаю..."
msgstr ""

# game/scripts/story_01/dinners.rpy:368 #-#-# translate crowdin ev_067_0a8e3fca:
msgid "[_Ann_s_14_] Что это ещё за «не знаю», Макс?! Тебе что, сложно сестре помочь?"
msgstr ""

# game/scripts/story_01/dinners.rpy:369 #-#-# translate crowdin ev_067_b7af8a11:
msgid "[_Max_s_16_] Но, мам! Как будто мне больше нечем заняться по вечерам, кроме как Лизе с домашними заданиями помогать!"
msgstr ""

# game/scripts/story_01/dinners.rpy:370 #-#-# translate crowdin ev_067_2d5c33ea:
msgid "[_Ann_s_10_] Да что ты, куча дел у тебя по вечерам, да? Ну и какие, например?"
msgstr ""

# game/scripts/story_01/dinners.rpy:371 #-#-# translate crowdin ev_067_53992974:
msgid "[_Max_s_14_] Я это... Чёрт..."
msgstr ""

# game/scripts/story_01/dinners.rpy:372 #-#-# translate crowdin ev_067_6c194838:
msgid "[_Ann_s_14_] Вот именно, Макс. Я знаю, что у нас и Лиза девочка умная, и ты у нас прекрасно учился, так что учти, если Лиза и дальше будет получать двойки, то я буду наказывать не только её, но и тебя."
msgstr ""

# game/scripts/story_01/dinners.rpy:373 #-#-# translate crowdin ev_067_067a869f:
msgid "[_Max_s_15_] Ничего себе новости! Мне прямо «нравится»!"
msgstr ""

# game/scripts/story_01/dinners.rpy:374 #-#-# translate crowdin ev_067_f96a71fd:
msgid "[_Alice_s_04_] Да, зрелище будет классное..."
msgstr ""

# game/scripts/story_01/dinners.rpy:375 #-#-# translate crowdin ev_067_f8f68790:
msgid "[_Ann_s_00_] Лиза, вы с Максом уже сами решите, как часто он будет тебе помогать. Раз в неделю или каждый день, тебе там виднее, но мне важен конечный результат."
msgstr ""

# game/scripts/story_01/dinners.rpy:376 #-#-# translate crowdin ev_067_3c4a17aa:
msgid "[_Lisa_s_11_] Хорошо, мам. Мы разберёмся."
msgstr ""

# game/scripts/story_01/dinners.rpy:377 #-#-# translate crowdin ev_067_015eeaa0:
msgid "[_Ann_s_01_] А ты, Алиса... Как у тебя дела с этим твоим блогом или чем там?"
msgstr ""

# game/scripts/story_01/dinners.rpy:378 #-#-# translate crowdin ev_067_be157aa2:
msgid "[_Alice_s_11_] Почти что никак, мам. Мне подруга обещала помочь, но это случится нескоро. Обещала заехать в гости и кое-что привезти с собой."
msgstr ""

# game/scripts/story_01/dinners.rpy:379 #-#-# translate crowdin ev_067_c5c51776:
msgid "[_Ann_s_12_] Ты только сама тоже усилия прикладывай, а не надейся на других людей. И не ищи оправданий, вроде того, что наши вещи потерялись."
msgstr ""

# game/scripts/story_01/dinners.rpy:380 #-#-# translate crowdin ev_067_5a40f473:
msgid "[_Alice_s_01_] Да, мам, я понимаю. Буду стараться всё, как можно быстрее, наверстать."
msgstr ""

# game/scripts/story_01/dinners.rpy:381 #-#-# translate crowdin ev_067_4cfad8bd:
msgid "[_Ann_s_03_] Вот и молодцы вы у меня! Ладно, всем большое спасибо за ужин. Было приятно с вами поболтать. А сейчас меня ждёт, как всегда, ванна..."
msgstr ""

# game/scripts/story_01/dinners.rpy:382 #-#-# translate crowdin ev_067_12502cd3:
msgid "[_Max_s_01_] Ага, всем спасибо..."
msgstr ""

# §translate crowdin strings: #|#|# # game/scripts/story_01/dinners.rpy:256
msgid "Мама! Дай Лизе шанс подготовиться. Я ей помогу!"
msgstr ""

# game/scripts/story_01/dinners.rpy:256
msgid "{i}не вмешиваться{/i}"
msgstr ""

